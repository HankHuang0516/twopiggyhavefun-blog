---
// Layout.astro - Bobowin Style with Black Header
interface Props {
    title: string;
    description?: string;
}

const { title, description, image, minimalHeader = false } = Astro.props;
const isHome = Astro.url.pathname === '/twopiggyhavefun-blog/' || Astro.url.pathname === '/twopiggyhavefun-blog';

const navLinks = [
    { name: '關於兩隻小豬', href: '/twopiggyhavefun-blog/about' },
    { name: '台灣好玩好吃趴趴走', href: '/twopiggyhavefun-blog/category/travel' },
    { name: '親子育兒', href: '/twopiggyhavefun-blog/category/parenting' },
    { name: '美食餐廳', href: '/twopiggyhavefun-blog/category/domestic-food' },
];
---

<!doctype html>
<html lang="zh-TW">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description || "兩隻小豬旅行親子生活 - 分享美食、旅遊、生活與親子育兒的點點滴滴"} />
        <meta name="viewport" content="width=device-width" />
        <link rel="alternate" hreflang="zh-TW" href={new URL(Astro.url.pathname, Astro.site)} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        <meta name="generator" content={Astro.generator} />
        <title>{title} | 兩隻小豬</title>
        
        <!-- SEO & Open Graph -->
        <meta property="og:title" content={`${title} | 兩隻小豬`} />
        <meta property="og:description" content={description || "兩隻小豬旅行親子生活 - 分享美食、旅遊、生活與親子育兒的點點滴滴"} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="兩隻小豬" />
        <meta property="og:site_name" content="兩隻小豬" />
        <meta property="og:image" content={image ? (image.startsWith('/') && !image.startsWith('/twopiggyhavefun-blog') ? `https://hankhuang0516.github.io/twopiggyhavefun-blog${image}` : image) : "https://hankhuang0516.github.io/twopiggyhavefun-blog/placeholder.jpg"} />

        <!-- Canonical URL -->
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap" rel="stylesheet">
    </head>
    <body class="bg-white text-gray-800">
        <!-- Reading Progress Bar -->
        <div id="progress-container" class="fixed top-0 left-0 w-full h-1.5 z-[999] bg-transparent">
            <div id="progress-bar" class="h-full bg-blue-600 transition-all duration-100 ease-out w-0"></div>
        </div>
        
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-white focus:text-blue-600 fixed top-0 left-0">
            跳至主要內容 (Skip to main content)
        </a>
        
        <!-- Mobile Minimal Header (Only show if minimalHeader is true) -->
        {minimalHeader && (
            <header class="block lg:hidden bg-black text-white p-3 shadow-md">
                <div class="container mx-auto flex items-center justify-between">
                    <a href="/twopiggyhavefun-blog/" class="flex items-center hover:text-gray-300 transition gap-2">
                        <span class="text-xl">⬅</span>
                        <span class="font-bold text-lg" style="color: #c9a961;">返回主畫面</span>
                    </a>
                    <span class="text-sm text-gray-400">兩隻小豬地圖</span>
                </div>
            </header>
        )}

        <!-- Main Header: Black Background with Gold Title (Matches bobowin) -->
        <!-- If minimalHeader is true, hide this on mobile (lg:block), otherwise show always -->
        <header class:list={['bg-black text-white', { 'hidden lg:block': minimalHeader }]}>
            <div class="container mx-auto px-4 py-6 text-center relative">
                <a href="/twopiggyhavefun-blog/" class="inline-block">
                    {isHome ? (
                        <h1 class="text-xl md:text-3xl font-bold tracking-wide" style="color: #c9a961;">
                            兩隻小豬旅行親子生活
                        </h1>
                    ) : (
                        <div class="text-xl md:text-3xl font-bold tracking-wide" style="color: #c9a961;">
                            兩隻小豬旅行親子生活
                        </div>
                    )}
                    <p class="text-gray-400 text-sm mt-1">我們的鏡頭帶著你四處漫遊</p>
                </a>
                
                <!-- Mobile Hamburger (Absolute Left) -->
                <button id="mobile-menu-btn" class="absolute left-4 top-1/2 -translate-y-1/2 text-white p-2 lg:hidden hover:text-[#c9a961] transition-colors" aria-label="Menu">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                <!-- Mobile Search Icon (Absolute Right) -->
                <button id="mobile-search-btn" class="absolute right-4 top-1/2 -translate-y-1/2 text-white p-2 lg:hidden hover:text-[#c9a961] transition-colors" aria-label="Search">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </button>
            </div>
            <!-- Navigation -->
            <nav class="border-t border-gray-700">
                <div class="container mx-auto px-4">
                    <ul class="flex flex-wrap justify-center">
                        {navLinks.map((link) => (
                            <li>
                                <a href={link.href} 
                                   class={`block px-4 py-3 text-sm hover:text-white transition ${Astro.url.pathname === link.href || (link.href !== '/twopiggyhavefun-blog/' && Astro.url.pathname.startsWith(link.href)) ? 'text-white font-bold border-b-2 border-[#c9a961]' : 'text-gray-300'}`}>
                                    {link.name}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </nav>
        </header>

        <main id="main-content" class="min-h-screen">
            <slot />
        </main>
        
        <!-- Footer: Matching bobowin style -->
        <footer class="bg-[#1a1a2e] text-gray-400 py-8 mt-12 pb-40 lg:pb-8 pb-[env(safe-area-inset-bottom,2rem)]">
            <div class="relative z-10 container mx-auto px-4 text-center text-white/80">
            <p>&copy; 2024 兩隻小豬 | All Rights Reserved. <span class="text-xs opacity-50 ml-2">v50.0 (Updated: {new Date().toLocaleTimeString()})</span></p>
        </div>
                <div class="flex flex-wrap justify-center gap-6">
                    <span class="text-gray-600">佈景：Flavor</span> 
                    <a href="/twopiggyhavefun-blog/about" style="color: #c9a961;" class="hover:underline hover:text-white transition p-2">
                        網頁設計：兩隻小豬
                    </a>
                </div>
            </div>
        </footer>

        <!-- Fixed Social Buttons (Right Side) - Bobowin Style -->
        <div id="achang-ft-btn" class="fixed right-2 top-1/2 -translate-y-1/2 z-50 hidden lg:block">
            <ul class="flex flex-col gap-2">
                <li class="w-12 h-12 rounded-full overflow-hidden" style="background-color: #f9cd9a;">
                    <a href="/twopiggyhavefun-blog/" class="block w-full h-full flex items-center justify-center">
                        <span class="text-2xl">🐷</span>
                    </a>
                </li>
                <li class="w-12 h-12 rounded-full overflow-hidden" style="background-color: #f9cd9a;">
                    <a href="https://www.facebook.com/twopiggyhavefun" target="_blank" rel="noopener noreferrer" class="block w-full h-full flex items-center justify-center">
                        <span class="text-xl text-blue-600 font-bold">f</span>
                    </a>
                </li>
                <li class="w-12 h-12 rounded-full overflow-hidden" style="background-color: #f9cd9a;">
                    <a href="https://www.instagram.com/twopiggyhavefun" target="_blank" rel="noopener noreferrer" class="block w-full h-full flex items-center justify-center">
                        <span class="text-xl">📷</span>
                    </a>
                </li>
                <li class="to-top w-12 h-12 rounded-full overflow-hidden" style="background-color: #f9cd9a;">
                    <a href="#" class="block w-full h-full flex items-center justify-center">
                        <span class="text-xl">⬆️</span>
                    </a>
                </li>
            </ul>
        </div>
        <!-- Back to Top Button (Optimized for Mobile) -->
        <button id="back-to-top" class="fixed bottom-28 right-4 bg-gray-800 text-white w-10 h-10 flex items-center justify-center rounded-full shadow-lg opacity-0 invisible transition-all duration-300 z-50 hover:bg-gray-700 hover:opacity-100" aria-label="Back to Top">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
        </button>

        <script>
            // Hamburger Menu Logic
            const menuBtn = document.getElementById('mobile-menu-btn');
            menuBtn?.addEventListener('click', () => {
                const event = new CustomEvent('open-sidebar');
                document.dispatchEvent(event);
            });

            // Mobile Search Button Logic
            const searchBtn = document.getElementById('mobile-search-btn');
            searchBtn?.addEventListener('click', () => {
                const event = new CustomEvent('open-sidebar');
                document.dispatchEvent(event);
                // Optional: Focus the search input after opening
                setTimeout(() => {
                    const searchInput = document.querySelector('.sidebar input[name="q"]') as HTMLInputElement;
                    if (searchInput) searchInput.focus();
                }, 300); // Wait for transition
            });

            // Back to Top Logic
            const backToTopBtn = document.getElementById('back-to-top');
            
            window.addEventListener('scroll', () => {
                if (window.scrollY > 300) {
                    backToTopBtn?.classList.remove('opacity-0', 'invisible');
                } else {
                    backToTopBtn?.classList.add('opacity-0', 'invisible');
                }
            });

            backToTopBtn?.addEventListener('click', () => {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });

            // Reading Progress Bar Logic
            const progressBar = document.getElementById('progress-bar');
            if (progressBar) {
                window.addEventListener('scroll', () => {
                    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                    const scrolled = (winScroll / height) * 100;
                    progressBar.style.width = scrolled + "%";
                });
            }
        </script>
    </body>
</html>

<style is:global>
    :root {
        /* Modern HSL Color Palette */
        --color-primary-hsl: 208, 56%, 46%; /* #337ab7 */
        --color-gold-hsl: 42, 53%, 58%;    /* #c9a961 */
        --color-black-hsl: 0, 0%, 0%;
        --color-white-hsl: 0, 0%, 100%;
        --color-text-hsl: 0, 0%, 20%;
        
        --color-primary: hsl(var(--color-primary-hsl));
        --color-gold: hsl(var(--color-gold-hsl));
        --color-black: hsl(var(--color-black-hsl));
        --color-white: hsl(var(--color-white-hsl));
        --color-text: hsl(var(--color-text-hsl));

        /* Shadows */
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }
    html {
        scroll-behavior: smooth;
    }
    body {
        font-family: 'Noto Sans TC', 'Microsoft JhengHei', sans-serif;
        font-size: 18px; /* Mobile First Base */
        line-height: 1.75;
    }
    a {
        color: var(--color-primary);
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
    /* Reset link styles for nav and buttons */
    nav a, .post-card a, .sidebar a, button, footer a {
        text-decoration: none;
    }
    
    /* Global External Link helper */
    /* Global External Link helper */
    .external-link::after {
        content: " ↗";
        font-size: 0.75em;
        vertical-align: super;
        margin-left: 2px;
        opacity: 0.6;
    }

    /* Round 39: Responsive Tables & List Polish */
    .pixnet-content table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
        max-width: 100%;
        margin: 1.5em 0;
        border-collapse: collapse;
    }
    .pixnet-content table th, .pixnet-content table td {
        border: 1px solid #e5e7eb;
        padding: 0.75rem;
    }
    .pixnet-content table th {
        background-color: #f9fafb;
        font-weight: bold;
    }
    
    /* Styled Dividers */
    .pixnet-content hr {
        border: 0;
        text-align: center;
        margin: 3rem 0;
        height: 1.5rem;
    }
    .pixnet-content hr::before {
        content: "•••";
        color: #d1d5db;
        font-size: 1.5rem;
        letter-spacing: 0.5rem;
    }

    /* List Typography */
    .pixnet-content ul {
        list-style-type: disc;
        padding-left: 1.5em;
        margin: 1em 0;
    }
    .pixnet-content ol {
        list-style-type: decimal;
        padding-left: 1.5em;
        margin: 1em 0;
    }
    .pixnet-content li {
        margin-bottom: 0.5em;
        padding-left: 0.5em;
    }
    .pixnet-content li::marker {
        color: #c9a961; /* Gold markers */
    }

    /* Copy Code Button */
    .code-container {
        position: relative;
        margin: 1.5em 0;
        max-height: 80vh;
        overflow-y: auto;
    }
    .copy-btn {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 0.25rem;
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        opacity: 0;
    }
    .code-container:hover .copy-btn {
        opacity: 1;
    }
    .copy-btn:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    /* Round 36: Premium Blockquotes */
    article .prose blockquote {
        border-left: 4px solid #c9a961;
        background: #f9fafb;
        padding: 1rem 1.5rem;
        margin: 1.5rem 0;
        font-style: italic;
        color: #4b5563;
        border-radius: 0 0.5rem 0.5rem 0;
    }
</style>

<script>
    // Copy Code Logic & Wrapper
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('pre').forEach(pre => {
            // Wrap pre in container
            const container = document.createElement('div');
            container.className = 'code-container group';
            pre.parentNode.insertBefore(container, pre);
            container.appendChild(pre);

            // Add button
            const btn = document.createElement('button');
            btn.className = 'copy-btn';
            btn.textContent = 'Copy';
            btn.addEventListener('click', () => {
                navigator.clipboard.writeText(pre.textContent).then(() => {
                    btn.textContent = 'Copied!';
                    setTimeout(() => btn.textContent = 'Copy', 2000);
                });
            });
            container.appendChild(btn);
        });

        // Wrap Tables for Responsiveness (Client-side fallback)
        document.querySelectorAll('.pixnet-content table').forEach(table => {
            if (!table.parentElement?.classList.contains('overflow-x-auto')) {
                const wrapper = document.createElement('div');
                wrapper.className = 'overflow-x-auto my-6';
                table.parentNode?.insertBefore(wrapper, table);
                wrapper.appendChild(table);
                
                // Add Touch Hint
                const hint = document.createElement('div');
                hint.className = 'text-xs text-center text-gray-400 mt-2 italic lg:hidden';
                hint.textContent = '← 左右滑動查看表格 →';
                wrapper.parentNode?.insertBefore(hint, wrapper.nextSibling);
            }
        });

        // External Link Handler (Round 46)
        const currentHost = window.location.hostname;
        document.querySelectorAll('article .prose a').forEach(link => {
            const href = link.getAttribute('href');
            if (href && href.startsWith('http') && !href.includes(currentHost) && !href.includes('hankhuang0516.github.io')) {
                link.setAttribute('target', '_blank');
                link.setAttribute('rel', 'noopener noreferrer');
                // Only add icon if link does NOT contain an image
                if (!link.querySelector('img')) {
                    link.classList.add('external-link');
                }
            }
        });
    });
    // Fade in images and Zoom logic...
    document.addEventListener('DOMContentLoaded', () => {
        const images = document.querySelectorAll('img');
        
        // Create Lightbox Elements
        const lightbox = document.createElement('div');
        lightbox.id = 'lightbox-modal';
        lightbox.className = 'fixed inset-0 z-[60] bg-black/90 hidden flex items-center justify-center cursor-zoom-out opacity-0 transition-opacity duration-300';
        lightbox.innerHTML = `
            <div class="relative w-full h-full flex items-center justify-center p-4">
                <img class="max-w-full max-h-full object-contain transform scale-95 transition-transform duration-300" src="">
                <button class="absolute top-12 right-6 text-white bg-black/50 w-10 h-10 rounded-full flex items-center justify-center hover:bg-black/70 transition">&times;</button>
            </div>
        `;
        document.body.appendChild(lightbox);
        
        const lightboxImg = lightbox.querySelector('img');
        const closeBtn = lightbox.querySelector('button');

        function closeLightbox() {
            lightbox.classList.remove('opacity-100');
            lightbox.classList.add('opacity-0');
            lightboxImg.classList.remove('scale-100');
            lightboxImg.classList.add('scale-95');
            setTimeout(() => {
                lightbox.classList.add('hidden');
            }, 300);
        }

        lightbox.addEventListener('click', closeLightbox);
        closeBtn.addEventListener('click', closeLightbox);

        // Double Click/Tap to Zoom
        lightboxImg.addEventListener('click', (e) => {
            e.stopPropagation(); // Prevent closing
        });
        lightboxImg.addEventListener('dblclick', (e) => {
            e.stopPropagation();
            if (lightboxImg.classList.contains('scale-150')) {
                lightboxImg.classList.remove('scale-150', 'cursor-zoom-out');
                lightboxImg.classList.add('cursor-zoom-in');
                lightboxImg.style.transform = '';
            } else {
                lightboxImg.classList.add('scale-150', 'cursor-zoom-out');
                lightboxImg.classList.remove('cursor-zoom-in');
                // Use CSS class or direct transform? Class is cleaner if defined, but scale-150 is standard tailwind 1.5x.
                // However, scale-100/150 might conflict with existing scale-95 stuff.
                // Let's rely on standard transform behavior.
                // Logic: Lightbox open sets scale-100. Double tap adds scale-150.
            }
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
        });

        images.forEach(img => {
            // Fade In
            img.style.opacity = '0';
            img.style.transition = 'opacity 0.5s ease-in-out';
            img.style.backgroundColor = '#f3f4f6'; // gray-100 placeholder
            if (img.complete) {
                img.style.opacity = '1';
                img.style.backgroundColor = 'transparent'; // Remove placeholder color on load
            } else {
                img.onload = () => {
                    img.style.opacity = '1';
                    img.style.backgroundColor = 'transparent';
                };
            }

            // Lightbox Click (only for content images or large images)
            // We exclude iconic svgs or small icons if possible, but for simplicity let's apply to all larger images
            if (img.width > 100 || img.classList.contains('object-cover')) {
                img.style.cursor = 'zoom-in';
                img.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    lightboxImg.src = img.src;
                    lightbox.classList.remove('hidden');
                    // Force reflow
                    void lightbox.offsetWidth; 
                    lightbox.classList.remove('opacity-0');
                    lightbox.classList.add('opacity-100');
                    lightboxImg.classList.remove('scale-95');
                    lightboxImg.classList.add('scale-100');
                });
            }
        });
    });
</script>
