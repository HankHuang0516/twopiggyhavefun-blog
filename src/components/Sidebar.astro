    <div class="lg:hidden flex items-center justify-between p-4 bg-gray-50 border-b border-gray-200">
        <span class="font-bold text-gray-700">選單 (Menu)</span>
        <button id="close-sidebar-btn" class="p-2 text-gray-500 hover:text-red-500 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>
    <SearchWidget />

    <!-- Profile Widget (Always visible, important for Trust) -->
    <div class="bg-white border border-gray-200 p-6 text-center">
        <div class="w-24 h-24 mx-auto bg-gray-200 rounded-full mb-4 overflow-hidden border-4 border-gray-50 shadow-inner">
             <img src="/twopiggyhavefun-blog/placeholder.jpg" alt="兩隻小豬" class="w-full h-full object-cover">
        </div>
        <h3 class="text-xl font-bold text-gray-800 mb-1">兩隻小豬</h3>
        <p class="text-xs text-gray-500 mb-4">旅行 / 美食 / 親子生活</p>
        <p class="text-sm text-gray-600 mb-4 leading-relaxed">
            我們是愛玩愛吃的一家人<br>
            喜歡分享生活中的點點滴滴<br>
            歡迎與我們一起探索世界！
        </p>
        <div class="flex justify-center gap-3">
             <a href="https://www.facebook.com/twopiggyhavefun" target="_blank" class="text-blue-600 hover:text-blue-800 bg-blue-50 p-2 rounded-full transition">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
             </a>
             <a href="https://www.instagram.com/twopiggyhavefun" target="_blank" class="text-pink-600 hover:text-pink-800 bg-pink-50 p-2 rounded-full transition">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
             </a>
        </div>
    </div>
    <div class="lg:hidden bg-white border border-gray-200 p-4">
        <h3 class="text-lg font-bold mb-3 text-red-600">主選單</h3>
        <ul class="space-y-2">
            <li><a href="/twopiggyhavefun-blog/about" class={`block hover:text-blue-600 ${Astro.url.pathname.includes('/about') ? 'text-blue-600 font-bold' : 'text-gray-700'}`}>關於兩隻小豬</a></li>
            <li><a href="/twopiggyhavefun-blog/category/travel" class={`block hover:text-blue-600 ${Astro.url.pathname.includes('/category/travel') ? 'text-blue-600 font-bold' : 'text-gray-700'}`}>台灣好玩好吃趴趴走</a></li>
            <li><a href="/twopiggyhavefun-blog/category/parenting" class={`block hover:text-blue-600 ${Astro.url.pathname.includes('/category/parenting') ? 'text-blue-600 font-bold' : 'text-gray-700'}`}>親子育兒</a></li>
            <li><a href="/twopiggyhavefun-blog/category/domestic-food" class={`block hover:text-blue-600 ${Astro.url.pathname.includes('/category/domestic-food') ? 'text-blue-600 font-bold' : 'text-gray-700'}`}>美食餐廳</a></li>
        </ul>
    </div>
    <!-- Article Categories -->
    <div class="bg-white border border-gray-200 p-4">
        <h3 class="text-lg font-bold mb-3 text-red-600">文章</h3>
        
        <!-- Expand/Collapse Links -->
        <div class="text-sm mb-3">
            <a href="javascript:void(0)" id="expandAll" class="text-blue-600 hover:underline">展開全部</a>
            <span class="text-gray-400 mx-1">|</span>
            <a href="javascript:void(0)" id="collapseAll" class="text-blue-600 hover:underline">收合全部</a>
        </div>
        
        <div class="dtree text-sm space-y-1">
            {parentOrder.map((parentName) => {
                const stats = categoryStats[parentName];
                if (!stats || stats.total === 0) return null;
                
                const config = PIXNET_CATEGORY_HIERARCHY[parentName as keyof typeof PIXNET_CATEGORY_HIERARCHY];
                const parentSlug = config?.slug || 'other';
                const catId = `cat-${parentSlug}`;
                
                // Get subcategories with posts, sorted by count
                const subsWithPosts = Object.entries(stats.subcategories)
                    .filter(([_, posts]) => posts.length > 0)
                    .sort((a, b) => b[1].length - a[1].length);
                
                return (
                    <div class="dtree-node">
                        <div class="flex items-center py-1">
                            <button class="toggle-btn w-8 h-8 flex items-center justify-center text-gray-400 hover:text-gray-600 active:bg-gray-100 rounded-full transition-colors -ml-1" data-target={catId}>
                                <span class="toggle-icon text-xs">▶</span>
                            </button>
                            <a href={`${BASE_URL}/category/${parentSlug}`} class="font-medium text-gray-800 hover:text-blue-600">
                                {parentName}
                            </a>
                            <span class="text-gray-400 text-xs ml-1">({stats.total})</span>
                        </div>
                        <div class="sub-categories ml-5 border-l border-gray-200 pl-3 hidden" id={catId}>
                            {subsWithPosts.map(([subName, posts]) => {
                                const uniquePosts = getUniquePosts(posts);
                                const subId = `sub-${parentSlug}-${subName.replace(/[^\w\u4e00-\u9fff]/g, '')}`;
                                
                                return (
                                    <div class="py-0.5">
                                        <div class="flex items-center">
                                            <button class="toggle-btn w-6 h-6 flex items-center justify-center text-gray-400 hover:text-gray-600 active:bg-gray-100 rounded-full transition-colors -ml-1 text-[10px]" data-target={subId}>
                                                <span class="toggle-icon">▶</span>
                                            </button>
                                            <a href={`${BASE_URL}/category/${subName}`} 
                                               class="text-blue-600 ml-1 hover:underline">{subName}</a>
                                            <span class="text-gray-400 text-xs ml-1">({uniquePosts.length})</span>
                                        </div>
                                        <div class="sub-posts ml-4 border-l border-gray-100 pl-2 hidden max-h-32 overflow-y-auto" id={subId}>
                                            {uniquePosts.slice(0, 8).map((post: any) => (
                                                <a href={`${BASE_URL}/posts/${post.slug}`} class="block text-blue-500 hover:underline text-xs py-0.5 truncate">
                                                    · {post.data.title}
                                                </a>
                                            ))}
                                            {uniquePosts.length > 8 && <span class="text-gray-400 text-xs">...還有 {uniquePosts.length - 8} 篇</span>}
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                );
            })}

            <!-- 全部文章 -->
            <div class="dtree-node mt-2 pt-2 border-t border-gray-200">
                <div class="flex items-center py-1">
                    <button class="toggle-btn w-5 text-gray-500" data-target="cat-all">
                        <span class="toggle-icon">▶</span>
                    </button>
                    <span class="font-medium text-blue-600">全部文章</span>
                    <span class="text-gray-400 text-xs ml-1">({allPosts.length})</span>
                </div>
                <div class="sub-posts ml-5 border-l border-gray-200 pl-3 hidden max-h-60 overflow-y-auto" id="cat-all">
                    {allPosts.slice(0, 20).map((post) => (
                        <a href={`${BASE_URL}/posts/${post.slug}`} class="block text-blue-500 hover:underline text-xs py-0.5 truncate">
                            · {post.data.title}
                        </a>
                    ))}
                    {allPosts.length > 20 && <span class="text-gray-400 text-xs">...還有 {allPosts.length - 20} 篇</span>}
                </div>
            </div>
        </div>
    </div>

    <!-- Website Stats -->
    <div class="bg-white border border-gray-200 p-4">
        <h3 class="font-bold mb-2 text-red-600">網站人氣統計</h3>
        <div class="text-sm text-gray-600">
            <p>今日人氣：<span class="font-medium">{stats.today.toLocaleString()}</span></p>
            <p>累計人氣：<span class="font-medium">{stats.total.toLocaleString()}</span></p>
        </div>
    </div>

    <!-- Recent Posts -->
    <div class="bg-white border border-gray-200 p-4">
        <h3 class="text-lg font-bold mb-4 text-red-600">近期文章</h3>
        <ul class="space-y-3">
            {recentPosts.map((post) => (
                <li>
                    <a href={`${BASE_URL}/posts/${post.slug}`} class="flex gap-3 group">
                        <img src={fixImagePath(post.data.cover)} 
                             alt={post.data.title}
                             class="w-16 h-12 object-cover rounded-sm flex-shrink-0 bg-gray-100" />
                        <div class="flex-1 min-w-0">
                            <!-- Use fragment set:html to render title correctly if it has entities, or just standard if not -->
                            <p class="text-sm text-gray-800 group-hover:text-blue-600 line-clamp-2 transition" set:html={post.data.title}>
                            </p>
                            <span class="text-xs text-gray-400">
                                {formatDate(post.data.date)}
                            </span>
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </div>
    <!-- Sidebar v44 Fixed -->

    <!-- Tags Cloud -->
    <div class="bg-white border border-gray-200 p-4">
        <h3 class="text-lg font-bold mb-4 text-red-600">熱門標籤</h3>
        <div class="flex flex-wrap gap-2">
            {['台北美食', '台中景點', '親子餐廳', '住宿推薦', '日本旅遊', '台灣小吃'].map(tag => (
                <a href={`/twopiggyhavefun-blog/tags/${tag}`} class="text-sm bg-gray-100 text-gray-700 px-3 py-2 rounded-md hover:bg-red-50 hover:text-red-500 transition shadow-sm">
                    #{tag}
                </a>
            ))}
        </div>
    </div>

    <!-- Search -->
    <div class="bg-white border border-gray-200 p-4">
        <form action={`${BASE_URL}/search`} method="get" class="flex">
            <input type="text" name="q" placeholder="搜尋文章..." 
                   class="flex-1 border border-gray-300 px-3 py-2 text-base focus:outline-none focus:border-blue-500" />
            <button type="submit" class="bg-gray-800 text-white px-4 py-2 text-sm hover:bg-gray-700 transition">
                搜尋
            </button>
        </form>
    </div>
</aside>

<style>
    .sub-categories.hidden, .sub-posts.hidden { display: none; }
    .toggle-btn { cursor: pointer; background: none; border: none; padding: 0; font-size: 10px; }
    .toggle-icon { display: inline-block; transition: transform 0.2s; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    
    /* External Link Icon for Content */
    .pixnet-content a[target="_blank"]::after {
        content: " ↗";
        font-size: 0.8em;
        opacity: 0.7;
    }
</style>

<script>
    // Close Sidebar Logic
    const closeBtn = document.getElementById('close-sidebar-btn');
    const sidebar = document.getElementById('sidebar-panel');
    const overlay = document.getElementById('sidebar-overlay');
    
    function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('hidden');
    }

    function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        overlay?.classList.remove('hidden');
    }
    
    closeBtn?.addEventListener('click', closeSidebar);
    overlay?.addEventListener('click', closeSidebar);

    // Listen for Open events from other components
    document.addEventListener('open-sidebar', openSidebar);
    
    // Legacy support for "Gear" button if it exists and we can attach to it
    // (Assuming the Gear button might be dynamically handled, we'll try to find it)
    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const gearBtn = target.closest('button, a');
        // Heuristic for Gear icon or Setup button
        if (gearBtn && (gearBtn.innerHTML.includes('card-text') || gearBtn.innerHTML.includes('gear') || gearBtn.innerText.includes('設定'))) {
            // Prevent default navigation if it's just a toggle
             if (gearBtn.getAttribute('href') === '#' || !gearBtn.getAttribute('href')) {
                e.preventDefault();
                openSidebar();
             }
        }
    });

    // Existing sidebar toggle logic...
    document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = btn.getAttribute('data-target');
            if (!targetId) return;
            const target = document.getElementById(targetId);
            const icon = btn.querySelector('.toggle-icon');
            if (target) {
                const isHidden = target.classList.contains('hidden');
                target.classList.toggle('hidden');
                if (icon) icon.textContent = isHidden ? '▼' : '▶';
            }
        });
    });

    document.getElementById('expandAll')?.addEventListener('click', () => {
        document.querySelectorAll('.sub-categories, .sub-posts').forEach(el => el.classList.remove('hidden'));
        document.querySelectorAll('.toggle-icon').forEach(el => el.textContent = '▼');
    });

    document.getElementById('collapseAll')?.addEventListener('click', () => {
        document.querySelectorAll('.sub-categories, .sub-posts').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.toggle-icon').forEach(el => el.textContent = '▶');
    });

    // Auto-close sidebar on mobile when a link is clicked
    const sidebarLinks = sidebar?.querySelectorAll('a');
    sidebarLinks?.forEach(link => {
        link.addEventListener('click', () => {
            // Only close if we are in mobile view (sidebar is fixed/absolute)
            // A simple check is if the overlay is visible or if window width is small
            if (window.innerWidth < 1024) { // lg breakpoint
                closeSidebar();
            }
        });
    });
</script>
