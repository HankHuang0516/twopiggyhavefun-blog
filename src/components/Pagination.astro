---
// Pagination.astro
interface Props {
  page: any;
}

const { page } = Astro.props;
---

<nav class="flex justify-center items-center gap-4 mt-12 mb-8">
  {page.url.prev ? (
    <a href={page.url.prev} class="px-4 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-600 transition shadow-sm font-medium flex items-center gap-2">
      <span>&larr;</span> 上一頁
    </a>
  ) : (
    <span class="px-4 py-2 bg-gray-50 border border-gray-100 text-gray-300 rounded-lg cursor-not-allowed font-medium flex items-center gap-2">
       <span>&larr;</span> 上一頁
    </span>
  )}

  <div class="text-gray-500 font-medium">
    第 <span class="text-gray-900">{page.currentPage}</span> 頁，共 <span class="text-gray-900">{page.lastPage}</span> 頁
  </div>

  {page.url.next ? (
    <a href={page.url.next} class="px-4 py-2 bg-white border border-gray-200 text-gray-700 rounded-lg hover:bg-gray-100 hover:text-blue-600 transition shadow-sm font-medium flex items-center gap-2">
      下一頁 <span>&rarr;</span>
    </a>
  ) : (
    <span class="px-4 py-2 bg-gray-50 border border-gray-100 text-gray-300 rounded-lg cursor-not-allowed font-medium flex items-center gap-2">
      下一頁 <span>&rarr;</span>
    </span>
  )}
</nav>
