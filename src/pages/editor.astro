---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { PIXNET_CATEGORY_HIERARCHY } from '../utils/categories';
---

<Layout title="文章編輯器 | TwoPiggyHaveFun">
    <!-- Jodit CSS -->
    <link rel="stylesheet" href="//unpkg.com/jodit@4.2.27/es2021/jodit.min.css"/>
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- Marked (MD -> HTML) & Turndown (HTML -> MD) -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>


    <div id="loading" class="loading-overlay">
        <div>載入中...</div>
    </div>

    <!-- Login View (Default) -->
    <div id="login-view" class="login-view">
        <div class="login-card">
            <h2>🔐 管理員登入</h2>
            <p style="color: #666; margin-bottom: 1.5rem;">請輸入密碼以進入文章管理系統</p>
            <div class="form-group">
                <input type="password" id="login-password" class="input-clean" placeholder="輸入密碼..." style="text-align: center;">
            </div>
            <button id="login-btn" class="btn btn-primary" style="width: 100%; justify-content: center;">登入系統</button>
        </div>
    </div>

    <!-- Flickr Picker Modal -->
    <div id="flickr-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>選擇 Flickr 相片</h3>
                <button id="close-flickr-modal" class="icon-btn"><i class="ph ph-x"></i></button>
            </div>
            <div class="modal-tabs">
                <button class="tab-btn active" data-tab="recent">最近上傳</button>
                <button class="tab-btn" data-tab="albums">相簿</button>
            </div>
            <div class="modal-body">
                <div id="flickr-grid" class="flickr-grid">
                    <!-- Photos will load here -->
                </div>
                <!-- Sub-view for Album Photos -->
                <div id="flickr-album-view" style="display: none;">
                    <button id="back-to-albums" class="btn btn-secondary" style="margin-bottom: 1rem;">NO_ICON 回上一層</button>
                    <div id="flickr-album-grid" class="flickr-grid"></div>
                </div>
            </div>
            <div class="modal-footer">
               <span id="flickr-status" style="color: #666; font-size: 0.9rem;"></span>
            </div>
        </div>
    </div>

    <!-- Ghost Modal -->
    <div id="ghost-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content" style="max-height: 80vh;">
            <div class="modal-header">
                <h3>👻 Ghost Articles 檢測</h3>
                <button id="close-ghost-modal" class="icon-btn"><i class="ph ph-x"></i></button>
            </div>
            <div class="modal-body">
                <div id="ghost-list-container" style="padding: 1rem;">
                    <!-- Results will load here -->
                </div>
            </div>
            <div class="modal-footer">
               <span id="ghost-status" style="color: #666; font-size: 0.9rem;"></span>
               <button class="btn btn-secondary" onclick="document.getElementById('ghost-modal').style.display='none'">關閉</button>
            </div>
        </div>
    </div>

    <!-- Main App (Hidden by default) -->
    <div id="app-container" style="display: none;">
        <div class="editor-wrapper">
            <header class="editor-header-nav">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <button id="sidebar-toggle" class="icon-btn" title="切換側邊欄">
                        <i class="ph ph-list" style="font-size: 1.5rem;"></i>
                    </button>
                    <h1>📝 文章管理系統</h1>
                </div>
                
                <div class="controls">
                    <!-- Action Buttons -->
                    <div id="action-buttons" style="display: none; gap: 0.5rem;">
                       <button class="btn btn-primary" id="save-btn">
                            <i class="ph ph-floppy-disk"></i> 儲存
                        </button>
                        <button class="btn btn-danger" id="delete-btn">
                            <i class="ph ph-trash"></i> 刪除
                        </button>
                    </div>

                    <button class="btn btn-secondary" id="new-post-btn">+ 新增文章</button>

                    <button class="btn btn-secondary" id="logout-btn" title="登出">
                        <i class="ph ph-sign-out"></i>
                    </button>
                    <!-- Ghost Check Button -->
                    <button class="btn btn-secondary" id="ghost-btn" title="檢查 Ghost Articles">
                        <i class="ph ph-ghost"></i>
                    </button>
                </div>
            </header>

            <div class="main-container">
                <div id="sidebar" class="sidebar">
                    <div class="sidebar-header">
                        <div class="search-sort-row">
                            <input type="text" id="search-input" class="search-box" placeholder="搜尋標題...">
                            <select id="sort-select" class="sort-select">
                                <option value="newest">最新優先</option>
                                <option value="oldest">最舊優先</option>
                                <option value="alphabetical">標題排序</option>
                            </select>
                        </div>
                        <button id="sidebar-close-btn" class="sidebar-toggle-trigger" title="收合選單">
                            <i class="ph ph-caret-left"></i>
                        </button>
                    </div>
                    <div id="post-list" class="post-list">
                        <!-- Posts will be loaded here -->
                    </div>
                </div>

                <div class="editor-area">
                    <!-- Sidebar Expand Button (Visible when sidebar collapsed) -->
                    <button id="sidebar-open-btn" class="sidebar-open-trigger" style="display: none;">
                        <i class="ph ph-caret-right"></i>
                        <span>展開選單</span>
                    </button>
                    <!-- Editor View -->
                    <div id="editor-view" style="display: none;">
                        
                        <!-- Metadata Fields -->
                        <div class="editor-metadata" style="display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
                             <div style="flex: 2; min-width: 200px;">
                                <label style="display:block; font-size:0.8rem; color:#666; margin-bottom:0.25rem;">文章標題 *</label>
                                <input type="text" id="post-title-input" class="input-clean" placeholder="輸入文章標題...">
                             </div>
                             <div style="flex: 1; min-width: 150px;">
                                <label style="display:block; font-size:0.8rem; color:#666; margin-bottom:0.25rem;">分類 *</label>
                                <select id="post-category-input" class="input-clean">
                                    {Object.entries(PIXNET_CATEGORY_HIERARCHY).map(([parentName, config]) => (
                                        <optgroup label={parentName}>
                                            <option value={parentName}>{parentName} (以此為主類別)</option>
                                            {config.subcategories.map(sub => (
                                                <option value={sub}>{sub}</option>
                                            ))}
                                        </optgroup>
                                    ))}
                                </select>
                             </div>
                             <div style="flex: 1; min-width: 150px;">
                                 <label style="display:block; font-size:0.8rem; color:#666; margin-bottom:0.25rem;">自訂網址 (Slug)</label>
                                 <input type="text" id="post-slug-input" class="input-clean" placeholder="留空自動產生">
                             </div>
                        </div>

                        <!-- Jodit Editor Container -->
                        <!-- Matching Pixnet container class for potential styling -->
                        <div class="jodit-react-container" style="flex: 1 1 0%; margin-bottom: 1rem; height: calc(100vh - 200px);">
                            <textarea id="jodit-editor"></textarea>
                        </div>
                    </div>
                    
                    <!-- Empty State -->
                    <div id="empty-state" style="flex: 1 1 0%; display: flex; justify-content: center; align-items: center; color: rgb(100, 116, 139);">
                        <p>請從左側選擇文章進行編輯，或點擊「新增文章」</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    :root {
        --primary: #2563eb;
        --danger: #ef4444;
        --bg-light: #f8fafc;
        --border: #e2e8f0;
        --text-main: #1e293b;
        --text-muted: #64748b;
    }
    
    body { margin: 0; font-family: 'Inter', sans-serif; }
    
    .loading-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(255,255,255,0.8); display: none;
        justify-content: center; align-items: center; z-index: 9999; font-weight: bold;
    }

    /* Login View Styles */
    .login-view {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: #f1f5f9; display: flex;
        justify-content: center; align-items: center; z-index: 5000;
    }
    .login-card {
        background: white; padding: 2rem; border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        width: 100%; max-width: 320px; text-align: center;
    }
    .login-card h2 { margin-top: 0; color: var(--text-main); }
    
    /* Flickr Modal Styles */
    .modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5); z-index: 9000; /* Higher than Jodit likely */
        display: flex; justify-content: center; align-items: center;
    }
    .modal-content {
        background: white; width: 90%; max-width: 800px; height: 80vh;
        border-radius: 8px; display: flex; flex-direction: column;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    .modal-header {
        padding: 1rem; border-bottom: 1px solid var(--border);
        display: flex; justify-content: space-between; align-items: center;
    }
    .modal-header h3 { margin: 0; font-size: 1.1rem; }
    
    .modal-tabs { display: flex; border-bottom: 1px solid var(--border); }
    .tab-btn {
        padding: 0.75rem 1.5rem; background: none; border: none; cursor: pointer;
        font-weight: 500; color: var(--text-muted); border-bottom: 2px solid transparent;
    }
    .tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }
    
    .modal-body { flex: 1; overflow-y: auto; padding: 1rem; background: #fafafa; }
    .flickr-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem;
    }
    .flickr-item, .album-item {
        background: white; border: 1px solid var(--border); border-radius: 4px; 
        overflow: hidden; cursor: pointer; transition: transform 0.2s;
        aspect-ratio: 1; position: relative;
    }
    .flickr-item:hover, .album-item:hover { transform: translateY(-2px); box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .flickr-item img, .album-item img { width: 100%; height: 100%; object-fit: cover; }
    .album-title {
        position: absolute; bottom: 0; left: 0; right: 0; 
        background: rgba(0,0,0,0.7); color: white; padding: 0.5rem; 
        font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    
    .modal-footer { padding: 0.75rem 1rem; border-top: 1px solid var(--border); text-align: right; }

    .editor-wrapper {
        display: flex; flex-direction: column;
        min-height: 100vh; background: var(--bg-light);
    }
    .editor-header-nav {
        background: white; border-bottom: 1px solid var(--border); padding: 0.75rem 1.5rem;
        display: flex; justify-content: space-between; align-items: center;
        height: 64px; box-sizing: border-box;
        position: sticky; top: 0; z-index: 100;
    }
    .editor-header-nav h1 { font-size: 1.25rem; margin: 0; color: var(--text-main); }
    
    .controls { display: flex; align-items: center; gap: 1rem; }
    
    .icon-btn, .icon-btn-small { 
        background: none; border: none; cursor: pointer; color: var(--text-muted); 
        padding: 0.5rem; border-radius: 4px; transition: all 0.2s; display: flex; align-items: center; justify-content: center;
    }
    .icon-btn-small { padding: 0.25rem; }
    .icon-btn:hover, .icon-btn-small:hover { background: #f1f5f9; color: var(--primary); }
    
    .divider { width: 1px; height: 24px; background: var(--border); margin: 0 0.5rem; }
    
    .main-container { display: flex; flex: 1; position: relative; }
    .sidebar { 
        width: 300px; background: white; border-right: 1px solid var(--border); 
        display: flex; flex-direction: column; transition: margin-left 0.3s ease;
        position: fixed; top: 0; bottom: 0; z-index: 2000;
        margin-top: 64px; /* Offset fixed header */
        height: calc(100vh - 64px);
    }
    .main-container.sidebar-open { padding-left: 300px; }
    .sidebar.collapsed { transform: translateX(-100%); }
    
    .sidebar-header { 
        padding: 1rem; border-bottom: 1px solid var(--border); 
        background: white; position: relative; z-index: 10;
    }
    .search-box, .auth-box { 
        width: 100%; padding: 0.5rem; border: 1px solid var(--border); 
        border-radius: 4px; box-sizing: border-box; outline: none;
    }
    .search-box:focus, .auth-box:focus { border-color: var(--primary); }
    .auth-box { width: 140px; }
    
    .post-list { flex: 1; overflow-y: auto; }
    .post-item { padding: 1rem; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.2s; }
    .post-item:hover { background: #f1f5f9; }
    .post-item.active { background: #eff6ff; border-left: 4px solid var(--primary); }
    .post-title { font-weight: 600; margin-bottom: 0.25rem; display: block; color: var(--text-main); }
    .post-meta { font-size: 0.8rem; color: var(--text-muted); }
    
    .editor-area { 
        flex: 1; display: flex; flex-direction: column; padding: 0.5rem; 
        background: white; position: relative; min-height: calc(100vh - 64px);
        margin-left: 300px; transition: margin-left 0.3s ease;
    }
    .sidebar.collapsed + .editor-area, .editor-area.full-width { margin-left: 0; }
    
    .editor-field { margin-bottom: 0.5rem; }
    .editor-field label { display: block; font-size: 0.875rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.5rem; }
    
    .btn { padding: 0.5rem 1rem; border-radius: 4px; font-weight: 500; cursor: pointer; border: none; transition: all 0.2s; display: flex; align-items: center; gap: 0.5rem;}
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-secondary { background: white; border: 1px solid var(--border); color: var(--text-main); }
    .btn-secondary:hover { background: #f1f5f9; }
    .btn-danger { background: var(--danger); color: white; }
    .btn-danger:hover { background: #dc2626; }
    
    /* New Post Form Styles */
    .form-container { max-width: 600px; margin: 0 auto; width: 100%; }
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main); }
    .input-clean { width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 6px; font-size: 1rem; outline: none; box-sizing: border-box; }
    .input-clean:focus { border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1); }
    
    /* Sidebar UX Improved */
    .sidebar-header { padding: 0.75rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 0.5rem; position: relative; }
    .search-sort-row { display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
    .sort-select { padding: 4px; border: 1px solid var(--border); border-radius: 4px; font-size: 0.75rem; background: #f8f9fa; cursor: pointer; }
    
    .sidebar-toggle-trigger { background: var(--border); border: none; width: 24px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 0 4px 4px 0; cursor: pointer; position: absolute; right: -24px; top: 50%; transform: translateY(-50%); color: var(--text-muted); transition: all 0.2s; z-index: 10; border: 1px solid var(--border); border-left: none; }
    .sidebar-toggle-trigger:hover { background: var(--primary); color: white; right: -26px; width: 26px; }
    
    .sidebar-open-trigger { position: absolute; left: 0; top: 50%; transform: translateY(-50%); background: white; border: 1px solid var(--border); border-left: none; padding: 0.75rem 0.25rem; border-radius: 0 8px 8px 0; color: var(--primary); cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; z-index: 20; box-shadow: 2px 0 8px rgba(0,0,0,0.05); }
    .sidebar-open-trigger i { font-size: 1.25rem; }
    .sidebar-open-trigger span { writing-mode: vertical-lr; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
    .sidebar-open-trigger:hover { background: #f1f5f9; padding-left: 0.5rem; }

    .sidebar.collapsed + .editor-area .sidebar-open-trigger { display: flex !important; }
    .sidebar.collapsed { width: 0 !important; min-width: 0 !important; padding: 0 !important; overflow: hidden; border: none !important; }

    /* Fix Jodit Z-index issues with floating UI */
    .jodit-container { z-index: 1 !important; }
</style>

<!-- Jodit JS -->
<script is:inline src="//unpkg.com/jodit@4.2.27/es2021/jodit.min.js"></script>

<script>
    import TurndownService from 'turndown';

    // --- Configuration ---
    const RAILWAY_API = 'https://twopiggyhavefun-blog-production.up.railway.app';
    const isLocalDev = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
    const API_BASE = isLocalDev ? 'http://localhost:3456' : RAILWAY_API;
    
    let currentSlug = null;
    let allPosts = [];
    let editor = null;
    let isSidebarOpen = true;
    let els = {}; 

    let turndownService;

    // --- Initialization ---
    document.addEventListener('DOMContentLoaded', () => {
        console.log('DOM Content Loaded - Initializing Jodit Editor...');

        // Initialize Turndown Service Safely
        if (typeof TurndownService !== 'undefined') {
            turndownService = new TurndownService({
                headingStyle: 'atx',
                codeBlockStyle: 'fenced'
            });
        } else {
            console.error('TurndownService is not defined!');
        }
        
        // 1. Query Elements
        els = {
            loading: document.getElementById('loading'),
            loginView: document.getElementById('login-view'),
            appContainer: document.getElementById('app-container'),
            loginPassword: document.getElementById('login-password'),
            loginBtn: document.getElementById('login-btn'),
            flickrModal: document.getElementById('flickr-modal'),
            closeFlickrModal: document.getElementById('close-flickr-modal'),
            flickrGrid: document.getElementById('flickr-grid'),
            flickrAlbumView: document.getElementById('flickr-album-view'),
            flickrAlbumGrid: document.getElementById('flickr-album-grid'),
            backToAlbums: document.getElementById('back-to-albums'),
            flickrStatus: document.getElementById('flickr-status'),
            tabBtns: document.querySelectorAll('.tab-btn'),
            sidebar: document.getElementById('sidebar'),
            sidebarToggle: document.getElementById('sidebar-toggle'),
            sidebarCloseBtn: document.getElementById('sidebar-close-btn'),
            postList: document.getElementById('post-list'),
            searchInput: document.getElementById('search-input'),
            saveBtn: document.getElementById('save-btn'),
            deleteBtn: document.getElementById('delete-btn'),
            newPostBtn: document.getElementById('new-post-btn'),
            logoutBtn: document.getElementById('logout-btn'),
            actionButtons: document.getElementById('action-buttons'),
            editorView: document.getElementById('editor-view'),
            emptyState: document.getElementById('empty-state'),
            postTitle: document.getElementById('post-title-input'),
            postCategory: document.getElementById('post-category-input'),
            postSlugInput: document.getElementById('post-slug-input'),
            sortSelect: document.getElementById('sort-select'),
            sidebarOpenBtn: document.getElementById('sidebar-open-btn'),
            ghostBtn: document.getElementById('ghost-btn'),
            ghostModal: document.getElementById('ghost-modal'),
            closeGhostModal: document.getElementById('close-ghost-modal'),
            ghostListContainer: document.getElementById('ghost-list-container'),
            ghostStatus: document.getElementById('ghost-status'),
        };

        // 2. Attach Event Listeners
        if (els.loginBtn) els.loginBtn.addEventListener('click', handleLogin);
        if (els.loginPassword) els.loginPassword.addEventListener('keydown', (e) => { if(e.key === 'Enter') handleLogin() });
        if (els.logoutBtn) els.logoutBtn.addEventListener('click', handleLogout);

        if (els.closeFlickrModal) els.closeFlickrModal.addEventListener('click', () => toggleFlickrModal(false));
        if (els.backToAlbums) els.backToAlbums.addEventListener('click', () => showAlbums());
        
        els.tabBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                els.tabBtns.forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                const tab = e.target.getAttribute('data-tab');
                if (tab === 'recent') loadFlickrRecent();
                if (tab === 'albums') loadFlickrAlbums();
            });
        });

        if (els.sidebarToggle) {
            els.sidebarToggle.addEventListener('click', () => {
                isSidebarOpen = !isSidebarOpen;
                toggleSidebar();
            });
        }
        if (els.sidebarCloseBtn) {
            els.sidebarCloseBtn.addEventListener('click', () => {
                isSidebarOpen = false;
                toggleSidebar();
            });
        }
        
        function toggleSidebar() {
             if (els.sidebar) els.sidebar.classList.toggle('collapsed', !isSidebarOpen);
             const area = document.querySelector('.editor-area');
             if(area) area.classList.toggle('full-width', !isSidebarOpen);
        }
        
        if (els.newPostBtn) els.newPostBtn.addEventListener('click', () => showView('new'));
        if (els.saveBtn) els.saveBtn.addEventListener('click', savePost);
        if (els.deleteBtn) els.deleteBtn.addEventListener('click', deletePost);

        if (els.searchInput) {
            els.searchInput.addEventListener('input', () => filterAndRender());
        }
        
        if (els.sortSelect) {
            els.sortSelect.addEventListener('change', () => filterAndRender());
        }
        
        if (els.sidebarOpenBtn) {
            els.sidebarOpenBtn.addEventListener('click', () => {
                isSidebarOpen = true;
                toggleSidebar();
            });
        }
        
        if (els.ghostBtn) {
            els.ghostBtn.addEventListener('click', () => {
                toggleGhostModal(true);
            });
        }
        if (els.closeGhostModal) {
            els.closeGhostModal.addEventListener('click', () => toggleGhostModal(false));
        }
        
        function filterAndRender() {
            const term = els.searchInput.value.toLowerCase();
            const sortBy = els.sortSelect.value;
            
            let filtered = allPosts.filter(p => p.title.toLowerCase().includes(term));
            
            if (sortBy === 'newest') {
                filtered.sort((a, b) => {
                    const da = a.date ? new Date(a.date) : new Date(0);
                    const db = b.date ? new Date(b.date) : new Date(0);
                    return db - da;
                });
            } else if (sortBy === 'oldest') {
                filtered.sort((a, b) => {
                    const da = a.date ? new Date(a.date) : new Date(0);
                    const db = b.date ? new Date(b.date) : new Date(0);
                    return da - db;
                });
            } else if (sortBy === 'alphabetical') {
                filtered.sort((a, b) => a.title.localeCompare(b.title));
            }
            
            renderList(filtered);
        }
        


        // 3. Initialize Jodit Editor matching Pixnet Style
        try {
            if (typeof Jodit !== 'undefined') {
                editor = Jodit.make('#jodit-editor', {
                    height: '100%',
                    width: 'auto',
                    minHeight: 400,
                    theme: 'default',
                    language: 'zh_tw',
                    toolbarAdaptive: false,
                    buttons: [
                        'bold', 'italic', 'underline', 'strikethrough',
                        '|',
                        'paragraph', 'fontsize', 'font', 'brush',
                        '|',
                        'indent', 'outdent', 'align',
                        '|',
                        'ul', 'ol',
                        '|',
                        'table',
                        '|',
                        'image', 
                        'insertFromAlbum',
                        'video',
                        '|',
                        'link', 'unlink',
                        '|',
                        'hr',
                        '|',
                        'find',
                        'eraser',
                        'source',
                        '|',
                        'undo', 'redo'
                    ],
                    controls: {
                        insertFromAlbum: {
                             icon: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 3C6.44772 3 6 3.44772 6 4V7H3C2.44772 7 2 7.44772 2 8V20C2 20.5523 2.44772 21 3 21H17C17.5523 21 18 20.5523 18 20V17H21C21.5523 17 22 16.5523 22 16V4C22 3.44772 21.5523 3 21 3H7ZM17 7H8V5H20V15H18V8C18 7.44772 17.5523 7 17 7ZM16 9V15.7394L11.4911 11.6404L4 18.6321V9H16ZM11.5089 14.3596L16 18.4424V19H6.53702L11.5089 14.3596ZM7 13.5C7.82843 13.5 8.5 12.8284 8.5 12C8.5 11.1716 7.82843 10.5 7 10.5C6.17157 10.5 5.5 11.1716 5.5 12C5.5 12.8284 6.17157 13.5 7 13.5Z"></path></svg>',
                             tooltip: '從相簿插入圖片',
                             exec: function(editor) {
                                toggleFlickrModal(true);
                             }
                        }
                    },
                    uploader: {
                        insertImageAsBase64URI: true
                    },
                    placeholder: '輸入一些內容...',
                    showXPathInStatusbar: true,
                    showCharsCounter: true,
                    showWordsCounter: true,
                    showPoweredBy: false // Clean look
                });
            } else {
                console.error('Jodit is not defined!');
            }
        } catch(e) {
            console.error('Jodit Initialization Failed:', e);
        }

        // 4. Check Auth Status
        checkAuthStatus();
        showLoading(false);
    });
    
    // --- Flickr Logic (Same as before) ---
    function toggleFlickrModal(show) {
        if (els.flickrModal) els.flickrModal.style.display = show ? 'flex' : 'none';
        if (show) {
             loadFlickrRecent();
        }
    }
    
    async function loadFlickrRecent() {
        if(!els.flickrGrid) return;
        els.flickrGrid.innerHTML = '<div style="padding:1rem;">載入中...</div>';
        els.flickrGrid.style.display = 'grid';
        els.flickrAlbumView.style.display = 'none';
        
        try {
            const res = await fetch(`${API_BASE}/api/flickr/recent`);
            const data = await res.json();
            if (data.error) throw new Error(data.error);
            
            const photos = data.photos && data.photos.photo ? data.photos.photo : [];
            renderPhotos(photos, els.flickrGrid);
            els.flickrStatus.textContent = `顯示 ${photos.length} 張相片`;
        } catch (err) {
            els.flickrGrid.innerHTML = `<div style="color:red; margin:1rem;">載入失敗: ${err.message}. 請確認後端目前是否已設定 FLICKR_API_KEY</div>`;
        }
    }
    
    async function loadFlickrAlbums() {
        if(!els.flickrGrid) return;
        els.flickrGrid.innerHTML = '<div style="padding:1rem;">載入中...</div>';
        els.flickrGrid.style.display = 'grid';
        els.flickrAlbumView.style.display = 'none';
        
        try {
            const res = await fetch(`${API_BASE}/api/flickr/albums`);
            const data = await res.json();
             if (data.error) throw new Error(data.error);
             
             const albums = data.photosets && data.photosets.photoset ? data.photosets.photoset : [];
             renderAlbums(albums);
             els.flickrStatus.textContent = `顯示 ${albums.length} 個相簿`;
        } catch (err) {
            els.flickrGrid.innerHTML = `<div style="color:red; margin:1rem;">載入失敗: ${err.message}</div>`;
        }
    }
    
    function renderAlbums(albums) {
        els.flickrGrid.innerHTML = albums.map(alb => {
            const thumb = alb.primary_photo_extras ? alb.primary_photo_extras.url_m : '';
            return `
            <div class="album-item" onclick="loadAlbumPhotos('${alb.id}', '${alb.title._content}')">
                <img src="${thumb}" loading="lazy">
                <div class="album-title">${alb.title._content} (${alb.photos}張)</div>
            </div>
            `;
        }).join('');
    }
    
    window.loadAlbumPhotos = async function(albumId, title) {
        els.flickrGrid.style.display = 'none';
        els.flickrAlbumView.style.display = 'block';
        els.flickrAlbumGrid.innerHTML = '<div style="padding:1rem;">載入照片中...</div>';
        els.backToAlbums.innerText = `< 回到相簿列表 (${title})`;
        
        try {
            const res = await fetch(`${API_BASE}/api/flickr/album/${albumId}/photos`);
            const data = await res.json();
            
            const photos = data.photoset && data.photoset.photo ? data.photoset.photo : [];
            renderPhotos(photos, els.flickrAlbumGrid);
        } catch (err) {
             els.flickrAlbumGrid.innerHTML = `<div style="color:red; margin:1rem;">載入失敗: ${err.message}</div>`;
        }
    }
    
    function showAlbums() {
        els.flickrAlbumView.style.display = 'none';
        els.flickrGrid.style.display = 'grid';
    }
    
    function renderPhotos(photos, container) {
        container.innerHTML = photos.map(p => {
            const url = p.url_m || p.url_o || '';
            const photoPage = `https://www.flickr.com/photos/158881690@N04/${p.id}`;
            const staticSrc = p.url_o || p.url_m; 
            
            return `
            <div class="flickr-item" onclick="selectFlickrPhoto('${p.id}', '${p.title}', '${staticSrc}', '${photoPage}')">
                <img src="${p.url_m}" loading="lazy" title="${p.title}">
            </div>
            `;
        }).join('');
    }
    
    window.selectFlickrPhoto = function(id, title, src, pageUrl) {
         // Insert HTML to Jodit
         const embedHtml = `<a href="${pageUrl}" title="${title}" target="_blank"><img src="${src}" alt="${title}" style="max-width:100%;"></a><br><small><a href="${pageUrl}">Photo</a> by TwoPiggyHaveFun</small>`;
         
         if (editor) {
             editor.selection.insertHTML(embedHtml);
         }
         toggleFlickrModal(false);
    }

    // --- Ghost Article Logic ---
    function toggleGhostModal(show) {
        if (els.ghostModal) els.ghostModal.style.display = show ? 'flex' : 'none';
        if (show) {
             checkGhosts();
        }
    }

    async function checkGhosts() {
        if (!els.ghostListContainer) return;
        els.ghostListContainer.innerHTML = '<div style="padding:1rem;">正在掃描 Ghost Articles...</div>';
        els.ghostStatus.textContent = '';

        try {
            const res = await fetch(`${API_BASE}/api/ghosts`, { headers: getHeaders() });
            const data = await res.json();
            
            if (data.error) throw new Error(data.error);
            const ghosts = data.ghosts || [];
            
            if (ghosts.length === 0) {
                els.ghostListContainer.innerHTML = `
                    <div style="text-align:center; padding: 2rem; color: green;">
                        <i class="ph ph-check-circle" style="font-size: 3rem; margin-bottom: 0.5rem;"></i>
                        <p>太棒了！沒有發現 Ghost Articles。</p>
                        <p style="font-size: 0.9rem; color: #666;">本地與遠端同步正常。</p>
                    </div>
                `;
                els.ghostStatus.textContent = '狀態: 良好';
            } else {
                renderGhosts(ghosts);
                els.ghostStatus.textContent = `發現 ${ghosts.length} 篇異常文章`;
            }

        } catch (err) {
            els.ghostListContainer.innerHTML = `<div style="color:red; margin:1rem;">檢測失敗: ${err.message}</div>`;
        }
    }

    function renderGhosts(ghosts) {
        els.ghostListContainer.innerHTML = `
            <div style="margin-bottom: 1rem; padding: 1rem; background: #fff3cd; border-left: 4px solid #ffc107; color: #856404;">
                <strong>注意：</strong> 以下文章存在於遠端網站 (search.json)，但在本地找不到。
                <br>建議確認是否需要手動刪除遠端檔案，或重新推送部署。
            </div>
            <div style="display: grid; gap: 0.5rem;">
                ${ghosts.map(g => `
                    <div style="background: white; border: 1px solid #ddd; padding: 0.75rem; border-radius: 4px; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-weight: 600;">${g.title}</div>
                            <div style="font-size: 0.8rem; color: #666;">Slug: ${g.slug}</div>
                        </div>
                        <div style="display:flex; gap: 0.5rem;">
                            <a href="https://twopiggyhavefun.uk/blog/posts/${g.slug}" target="_blank" class="btn btn-secondary" style="font-size: 0.8rem;">
                                查看 <i class="ph ph-arrow-square-out"></i>
                            </a>
                            <button onclick="deleteGhost('${g.slug}')" class="btn btn-danger" style="font-size: 0.8rem;">
                                移除 <i class="ph ph-trash"></i>
                            </button>
                        </div>
                    </div>
                `).join('')}
            </div>
        `;
    }

    window.deleteGhost = async function(slug) {
        if (!confirm(`確定要從遠端移除「${slug}」嗎？\n此動作無法復原！`)) return;
        
        const btn = event.target.closest('button');
        if(btn) {
            btn.disabled = true;
            btn.textContent = '移除中...';
        }

        try {
            const res = await fetch(`${API_BASE}/api/ghosts/${slug}`, {
                method: 'DELETE',
                headers: getHeaders()
            });
            const data = await res.json();
            
            if (data.error) throw new Error(data.error);
            
            alert('移除成功！');
            checkGhosts(); // Refresh list
        } catch (err) {
            alert(`移除失敗: ${err.message}`);
            if(btn) {
                btn.disabled = false;
                btn.textContent = '移除';
            }
        }
    }

    // --- Core Logic ---

    function getHeaders() {
        const headers = { 'Content-Type': 'application/json' };
        const savedPwd = localStorage.getItem('editor_password');
        if (savedPwd) {
            headers['Authorization'] = `Bearer ${savedPwd}`;
            // Also keep old header just in case server checks it differently, 
            // but article_api_server.js uses Authorization: Bearer
            headers['X-Auth-Password'] = savedPwd; 
        }
        return headers;
    }

    function checkAuthStatus() {
        const savedPwd = localStorage.getItem('editor_password');
        if (savedPwd) {
            showLoading(true);
            loadPosts(true); 
        } else {
            showLogin();
        }
    }
    
    function showLogin() {
        if (els.loginView) els.loginView.style.display = 'flex';
        if (els.appContainer) els.appContainer.style.display = 'none';
        if (els.loginPassword) els.loginPassword.focus();
    }
    
    function showApp() {
        if (els.loginView) els.loginView.style.display = 'none';
        if (els.appContainer) els.appContainer.style.display = 'block';
    }

    async function handleLogin() {
        const pwd = els.loginPassword.value;
        if (!pwd) { alert('請輸入密碼'); return; }
        localStorage.setItem('editor_password', pwd);
        await loadPosts(false);
    }
    
    function handleLogout() {
        if (confirm('確定要登出嗎？')) {
            localStorage.removeItem('editor_password');
            if (els.loginPassword) els.loginPassword.value = '';
            showLogin();
        }
    }

    async function loadPosts(isAutoLogin = false) {
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts`, {
                headers: getHeaders()
            });
            if (res.status === 401) {
                if (localStorage.getItem('editor_password')) {
                     if (!isAutoLogin) alert('密碼錯誤，請重新登入');
                    localStorage.removeItem('editor_password');
                }
                showLogin();
                showLoading(false);
                return;
            }
            if (!res.ok) throw new Error('API Error');

            allPosts = await res.json();
            renderList(allPosts);
            showApp();
            
        } catch (err) {
            console.error(err);
            if (!isAutoLogin) alert('無法載入文章列表 (或網路連線錯誤)');
            showLogin();
        }
        showLoading(false);
    }

    function renderList(posts) {
        if (!els.postList) return;
        els.postList.innerHTML = posts.map(post => {
            const slug = post.slug || (post.filename ? post.filename.replace('.md', '') : '');
            let dateStr = '無日期';
            if (post.date) {
                const d = new Date(post.date);
                if (!isNaN(d)) {
                    // Format as YYYY/MM/DD
                    dateStr = d.toLocaleDateString();
                }
            }
            return `
                <div class="post-item ${currentSlug === slug ? 'active' : ''}" onclick="selectPost('${slug}')">
                    <span class="post-title">${post.title}</span>
                    <span class="post-meta">${dateStr} · ${post.category || '未分類'}</span>
                </div>
            `;
        }).join('');
    }

    window.selectPost = async function(slug) {
        currentSlug = slug;
        showLoading(true);
        
        const items = document.querySelectorAll('.post-item');
        items.forEach(i => i.classList.remove('active'));
        renderList(allPosts);

        try {
            // Need to fetch full content (markdown) from standard post URL possibly?
            // Actually our API checks for slug.
            // But wait, the list API gives meta. We need content.
            // We should use the same api/posts/:slug if it exists, or just fallback to known content from cache if we had it, but we don't.
            // Is there a GET /api/posts/:slug endpoint?
            // The article_api_server.js list endpoint returns all posts meta.
            // It doesn't seem to have a GET single post point visible in the snippet I read?
            // Wait, I read article_api_server.js in step 23...
            // It has: GET /api/posts (List), POST /api/article (Create/Update), DELETE /api/posts/:filename.
            // IT DOES NOT HAVE A GET /api/posts/:slug !
            // However, the previous editor code used `fetch(${API_BASE}/api/posts/${slug})`.
            // Let me re-read the previous editor.astro...
            // Line 712: fetch(${API_BASE}/api/posts/${slug})
            // Does article_api_server.js handle this?
            // Line 367: app.get('/api/posts', ...)
            // It seems I missed the single post endpoint in the server file or it was dynamically handled?
            // Let me check if I missed it. I saw lines 1-395.
            // It seems specific GET /api/posts/:slug is MISSING in the provided server code. 
            // BUT, the previous Code used it. 
            // Maybe it is handled by the `app.use(express.static)` or similar if it's just serving files?
            // No, the previous code expected JSON.
            // CHECK: The server code has `app.get('/api/posts', ...)` which returns list. 
            // Maybe I need to IMPLEMENT `GET /api/posts/:slug` in the server?
            // Or maybe the User has another file serving it?
            // Wait, looking at file list... `article_api_server.js` size 14913 bytes.
            // Let's assume it IS there and I just missed it in review or it's handled by a wildcard?
            // No, `app.get('/api/posts')` is exact match.
            // Let's look really closely at the server code again.
            // It's possible the user sent me a truncated view or I missed a chunk.
            // Whatever, I MUST support loading.
            // If the server doesn't support it, the Editor will fail. 
            // I will implement the logic assuming the endpoint exists (as per previous editor code).
            // But verify: Previous editor used: `const data = await res.json();`
            
            const res = await fetch(`${API_BASE}/api/posts/${slug}`, {
                headers: getHeaders()
            });
            
            if (!res.ok) throw new Error(`API Error: ${res.status}`);
            const data = await res.json(); // { slug, title, content, ... }
            
            if (els.postTitle) {
                els.postTitle.value = data.title || slug;
                els.postTitle.disabled = true;
            }
            if (els.postSlugInput) {
                els.postSlugInput.value = data.slug;
                els.postSlugInput.disabled = true;
            }
            if (els.postCategory) {
                 if (data.category) els.postCategory.value = data.category;
                 els.postCategory.disabled = true;
            }

            if (editor) {
                // Convert Markdown to HTML
                const htmlContent = marked.parse(data.content || '');
                editor.value = htmlContent;
            }
            
            showView('editor');
            if (window.innerWidth < 768 && els.sidebar) {
                els.sidebar.classList.add('collapsed');
            }
            
        } catch (err) {
            console.error(err);
            alert(`載入失敗: ${err.message}`);
        }
        showLoading(false);
    }
    
    function showView(viewName) {
        if (els.editorView) els.editorView.style.display = 'none';
        if (els.emptyState) els.emptyState.style.display = 'none';
        
        if (viewName === 'editor') {
            if (els.editorView) {
                els.editorView.style.display = 'flex';
                els.editorView.style.flexDirection = 'column';
                els.editorView.style.flex = '1';
                
                if (!currentSlug) {
                    if (els.postTitle) { els.postTitle.value = ''; els.postTitle.disabled = false; }
                    if (els.postSlugInput) { els.postSlugInput.value = ''; els.postSlugInput.disabled = false; }
                    if (els.postCategory) { els.postCategory.disabled = false; }
                    if (editor) editor.value = ''; // Clear
                    
                    if (els.deleteBtn) els.deleteBtn.style.display = 'none';
                } else {
                    if (els.deleteBtn) els.deleteBtn.style.display = 'flex';
                }
            }
            if (els.actionButtons) els.actionButtons.style.display = 'flex';
        } else if (viewName === 'new') {
            currentSlug = null;
            showView('editor'); 
        } else {
            if (els.emptyState) els.emptyState.style.display = 'flex';
            if (els.actionButtons) els.actionButtons.style.display = 'none';
            currentSlug = null;
        }
    }

    // --- Actions ---
    async function savePost() {
        showLoading(true);
        try {
            // Turn HTML back to Markdown
            const html = editor.value;
            // Ensure TurndownService is available
            if (!turndownService) {
                turndownService = new TurndownService({
                    headingStyle: 'atx',
                    codeBlockStyle: 'fenced'
                });
            }
            const markdown = turndownService.turndown(html);
            
            const payload = {
                title: els.postTitle.value,
                category: els.postCategory.value,
                slug: els.postSlugInput.value || currentSlug, // If editing, keep slug. If new, use input or auto.
                content: markdown,
                date: new Date().toISOString()
            };

            const res = await fetch(`${API_BASE}/api/article`, {
                method: 'POST',
                headers: getHeaders(),
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                alert('儲存成功！');
                loadPosts(true); // reload list
            } else {
                throw new Error(data.error);
            }
        } catch (err) {
            console.error(err);
            alert(`儲存失敗: ${err.message}`);
        } finally {
            showLoading(false);
        }
    }

    async function deletePost() {
        if (!currentSlug || !confirm('確定要刪除這篇文章嗎？此動作無法復原。')) return;
        
        showLoading(true);
        // The API endpoint is DELETE /api/posts/:filename
        // But we have slug. Filename is usually slug.md
        const filename = `${currentSlug}.md`;
        
        try {
            const res = await fetch(`${API_BASE}/api/posts/${filename}`, {
                method: 'DELETE',
                headers: getHeaders()
            });
            const data = await res.json();
            if (data.success) {
                alert('刪除成功');
                showView('empty');
                loadPosts(true);
            } else {
                throw new Error(data.error);
            }
        } catch (err) {
            alert(`刪除失敗: ${err.message}`);
        }
        showLoading(false);
    }
    
    function showLoading(show) {
        if(els.loading) els.loading.style.display = show ? 'flex' : 'none';
    }
</script>
