---
import Layout from '../layouts/Layout.astro';
---

<Layout title="文章編輯器 | TwoPiggyHaveFun">
    <!-- Toast UI Editor CSS -->
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css" />
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/theme/toastui-editor-dark.min.css" />
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <div id="loading" class="loading-overlay">
        <div>載入中...</div>
    </div>

    <div class="editor-wrapper">
        <header class="editor-header-nav">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <button id="sidebar-toggle" class="icon-btn" title="切換側邊欄">
                    <i class="ph ph-list" style="font-size: 1.5rem;"></i>
                </button>
                <h1>📝 文章管理系統</h1>
            </div>
            
            <div class="controls">
                <div class="auth-container">
                    <div class="password-wrapper">
                        <input type="password" id="auth-password" class="auth-box" placeholder="輸入密碼...">
                        <button id="toggle-password" class="icon-btn-small" title="顯示密碼">
                            <i class="ph ph-eye"></i>
                        </button>
                    </div>
                    <button class="btn btn-primary" id="auth-btn">確認</button>
                </div>
                
                <div class="divider"></div>

                <div id="action-buttons" style="display: none; gap: 0.5rem;">
                   <button class="btn btn-primary" id="save-btn">
                        <i class="ph ph-floppy-disk"></i> 儲存
                    </button>
                    <button class="btn btn-danger" id="delete-btn">
                        <i class="ph ph-trash"></i> 刪除
                    </button>
                </div>

                <button class="btn btn-secondary" id="new-post-btn">+ 新增文章</button>
            </div>
        </header>

        <div class="main-container">
            <div id="sidebar" class="sidebar">
                <div class="sidebar-header">
                    <input type="text" id="search-input" class="search-box" placeholder="搜尋標題...">
                </div>
                <div id="post-list" class="post-list">
                    <!-- Posts will be loaded here -->
                </div>
            </div>

            <div class="editor-area">
                <!-- Editor View -->
                <div id="editor-view" style="display: none;">
                    <div class="editor-title-container">
                        <h2 id="editor-title-display">編輯文章</h2>
                    </div>
                    
                    <div class="editor-field">
                        <label>檔案名稱 (Slug)</label>
                        <input type="text" id="post-slug" disabled class="input-light">
                    </div>

                    <div id="toast-editor-container" style="flex: 1; margin-bottom: 1rem;"></div>
                </div>
                
                <!-- Empty State -->
                <div id="empty-state" style="flex: 1; display: flex; justify-content: center; align-items: center; color: #64748b;">
                    <p>請從左側選擇文章進行編輯，或點擊「新增文章」</p>
                </div>

                <!-- New Post View -->
                <div id="new-post-view" style="display: none;">
                    <div class="form-container">
                        <h2>📝 新增文章</h2>
                        
                        <div class="form-group">
                            <label>文章標題 *</label>
                            <input type="text" id="new-title" placeholder="輸入文章標題..." class="input-clean">
                        </div>

                        <div class="form-group">
                            <label>分類 *</label>
                            <select id="new-category" class="input-clean">
                                <optgroup label="台北">
                                    <option value="taipei-food">台北美食</option>
                                    <option value="taipei-attractions">台北景點</option>
                                </optgroup>
                                <optgroup label="新北">
                                    <option value="newtaipei-food">新北美食</option>
                                    <option value="newtaipei-attractions">新北景點</option>
                                </optgroup>
                                <optgroup label="桃園">
                                    <option value="taoyuan-food">桃園美食</option>
                                    <option value="taoyuan-attractions">桃園景點</option>
                                </optgroup>
                                <optgroup label="其他地區">
                                    <option value="hsinchu-food">新竹美食</option>
                                    <option value="hsinchu-attractions">新竹景點</option>
                                    <option value="taichung-food">台中美食</option>
                                    <option value="taichung-attractions">台中景點</option>
                                    <option value="tainan-food">台南美食</option>
                                    <option value="tainan-attractions">台南景點</option>
                                    <option value="kaohsiung-food">高雄美食</option>
                                    <option value="kaohsiung-attractions">高雄景點</option>
                                    <option value="yilan-food">宜蘭美食</option>
                                    <option value="yilan-attractions">宜蘭景點</option>
                                </optgroup>
                                <optgroup label="其他">
                                    <option value="life">生活雜記</option>
                                    <option value="uncategorized">未分類</option>
                                </optgroup>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>自訂檔名 (Slug, 選填)</label>
                            <input type="text" id="new-slug" placeholder="例如: taipei-101-visit (留空則自動產生)" class="input-clean">
                            <small>只允許英文、數字與連字號</small>
                        </div>
                        
                        <div class="form-actions">
                            <button class="btn btn-primary" id="create-post-btn">建立文章</button>
                            <button class="btn btn-secondary" id="cancel-new-btn">取消</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    :root {
        --primary: #2563eb;
        --danger: #ef4444;
        --bg-light: #f8fafc;
        --border: #e2e8f0;
        --text-main: #1e293b;
        --text-muted: #64748b;
    }
    
    body { margin: 0; font-family: 'Inter', sans-serif; }
    
    .loading-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(255,255,255,0.8); display: none;
        justify-content: center; align-items: center; z-index: 9999; font-weight: bold;
    }
    .editor-wrapper {
        display: flex; flex-direction: column;
        height: 100vh; background: var(--bg-light);
    }
    .editor-header-nav {
        background: white; border-bottom: 1px solid var(--border); padding: 0.75rem 1.5rem;
        display: flex; justify-content: space-between; align-items: center;
        height: 64px; box-sizing: border-box;
    }
    .editor-header-nav h1 { font-size: 1.25rem; margin: 0; color: var(--text-main); }
    
    .controls { display: flex; align-items: center; gap: 1rem; }
    .auth-container { display: flex; gap: 0.5rem; }
    .password-wrapper { position: relative; display: flex; align-items: center; }
    .icon-btn, .icon-btn-small { 
        background: none; border: none; cursor: pointer; color: var(--text-muted); 
        padding: 0.5rem; border-radius: 4px; transition: all 0.2s; display: flex; align-items: center; justify-content: center;
    }
    .icon-btn-small { padding: 0.25rem; }
    .icon-btn:hover, .icon-btn-small:hover { background: #f1f5f9; color: var(--primary); }
    
    .divider { width: 1px; height: 24px; background: var(--border); margin: 0 0.5rem; }
    
    .main-container { display: flex; flex: 1; overflow: hidden; }
    .sidebar { 
        width: 300px; background: white; border-right: 1px solid var(--border); 
        display: flex; flex-direction: column; transition: margin-left 0.3s ease;
    }
    .sidebar.collapsed { margin-left: -300px; }
    
    .sidebar-header { padding: 1rem; border-bottom: 1px solid var(--border); }
    .search-box, .auth-box { 
        width: 100%; padding: 0.5rem; border: 1px solid var(--border); 
        border-radius: 4px; box-sizing: border-box; outline: none;
    }
    .search-box:focus, .auth-box:focus { border-color: var(--primary); }
    .auth-box { width: 140px; }
    
    .post-list { flex: 1; overflow-y: auto; }
    .post-item { padding: 1rem; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.2s; }
    .post-item:hover { background: #f1f5f9; }
    .post-item.active { background: #eff6ff; border-left: 4px solid var(--primary); }
    .post-title { font-weight: 600; margin-bottom: 0.25rem; display: block; color: var(--text-main); }
    .post-meta { font-size: 0.8rem; color: var(--text-muted); }
    
    .editor-area { flex: 1; display: flex; flex-direction: column; padding: 2rem; background: white; overflow-y: auto; position: relative; }
    
    .editor-field { margin-bottom: 1rem; }
    .editor-field label { display: block; font-size: 0.875rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.5rem; }
    
    .btn { padding: 0.5rem 1rem; border-radius: 4px; font-weight: 500; cursor: pointer; border: none; transition: all 0.2s; display: flex; align-items: center; gap: 0.5rem;}
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-secondary { background: white; border: 1px solid var(--border); color: var(--text-main); }
    .btn-secondary:hover { background: #f1f5f9; }
    .btn-danger { background: var(--danger); color: white; }
    .btn-danger:hover { background: #dc2626; }
    
    /* New Post Form Styles */
    .form-container { max-width: 600px; margin: 0 auto; width: 100%; }
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main); }
    .input-clean { width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 6px; font-size: 1rem; outline: none; box-sizing: border-box; }
    .input-clean:focus { border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1); }
    .form-actions { display: flex; gap: 1rem; margin-top: 2rem; }
    
    /* Toast UI Customization */
    .toastui-editor-defaultUI { border: 1px solid var(--border) !important; border-radius: 6px; }
    #toast-editor-container { background: white; }
</style>

<!-- Toast UI Editor JS -->
<script is:inline src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

<script is:inline>
    // --- Configuration ---
    const RAILWAY_API = 'https://twopiggyhavefun-blog-production.up.railway.app';
    const isLocalDev = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
    const API_BASE = isLocalDev ? 'http://localhost:3456' : RAILWAY_API;
    
    let currentSlug = null;
    let allPosts = [];
    let editor = null;
    let isSidebarOpen = true;
    let els = {}; // Initialize empty

    // --- Initialization ---
    // Ensure DOM is ready before querying elements
    document.addEventListener('DOMContentLoaded', () => {
        console.log('DOM Content Loaded - Initializing Editor...');
        
        // 1. Query Elements
        els = {
            loading: document.getElementById('loading'),
            authPassword: document.getElementById('auth-password'),
            authBtn: document.getElementById('auth-btn'),
            togglePw: document.getElementById('toggle-password'),
            
            postList: document.getElementById('post-list'),
            searchInput: document.getElementById('search-input'),
            
            saveBtn: document.getElementById('save-btn'),
            deleteBtn: document.getElementById('delete-btn'),
            newPostBtn: document.getElementById('new-post-btn'),
            actionButtons: document.getElementById('action-buttons'),
            
            sidebar: document.getElementById('sidebar'),
            sidebarToggle: document.getElementById('sidebar-toggle'),
            
            // Views
            editorView: document.getElementById('editor-view'),
            emptyState: document.getElementById('empty-state'),
            newPostView: document.getElementById('new-post-view'),
            
            // Inputs
            postSlug: document.getElementById('post-slug'),
            
            // New Post Form
            newTitle: document.getElementById('new-title'),
            newCategory: document.getElementById('new-category'),
            newSlug: document.getElementById('new-slug'),
            createPostBtn: document.getElementById('create-post-btn'),
            cancelNewBtn: document.getElementById('cancel-new-btn'),
        };

        // 2. Attach Event Listeners (safely)
        if (els.authBtn) els.authBtn.addEventListener('click', handleLogin);
        else console.error('Auth Button not found!');

        if (els.authPassword) els.authPassword.addEventListener('keydown', (e) => { if(e.key === 'Enter') handleLogin() });
        
        if (els.togglePw) els.togglePw.addEventListener('click', () => {
            const type = els.authPassword.getAttribute('type') === 'password' ? 'text' : 'password';
            els.authPassword.setAttribute('type', type);
            els.togglePw.querySelector('i').classList.toggle('ph-eye');
            els.togglePw.querySelector('i').classList.toggle('ph-eye-slash');
        });

        if (els.sidebarToggle) els.sidebarToggle.addEventListener('click', () => {
            isSidebarOpen = !isSidebarOpen;
            if (isSidebarOpen) els.sidebar.classList.remove('collapsed');
            else els.sidebar.classList.add('collapsed');
        });

        if (els.saveBtn) els.saveBtn.addEventListener('click', savePost);
        if (els.deleteBtn) els.deleteBtn.addEventListener('click', deletePost);
        
        if (els.searchInput) els.searchInput.addEventListener('input', (e) => {
            const q = e.target.value.toLowerCase();
            renderList(allPosts.filter(p => p.title.toLowerCase().includes(q)));
        });

        if (els.newPostBtn) els.newPostBtn.addEventListener('click', () => showView('new'));
        if (els.cancelNewBtn) els.cancelNewBtn.addEventListener('click', () => showView('empty'));
        if (els.createPostBtn) els.createPostBtn.addEventListener('click', textCreatePost);

        // 3. Restore Password
        if (localStorage.getItem('editor_password') && els.authPassword) {
            els.authPassword.value = localStorage.getItem('editor_password');
        }

        // 4. Start App
        initEditor();
        loadPosts();
    });

    // --- Toast UI ---
    function initEditor() {
        // @ts-ignore
        const Editor = toastui.Editor;
        
        // Custom Flickr Button
        const flickrButton = document.createElement('button');
        flickrButton.className = 'image toastui-editor-toolbar-icons';
        flickrButton.style.backgroundImage = 'none'; 
        flickrButton.style.margin = '0';
        flickrButton.innerHTML = '<i class="ph ph-image-square" style="font-size: 18px; color: #555;"></i>';
        flickrButton.title = '插入 Flickr 相簿';
        flickrButton.addEventListener('click', insertFlickrAlbum);

        editor = new Editor({
            el: document.querySelector('#toast-editor-container'),
            height: 'calc(100vh - 250px)',
            initialEditType: 'markdown',
            previewStyle: 'vertical',
            language: 'zh-TW',
            initialValue: '',
            toolbarItems: [
                ['heading', 'bold', 'italic', 'strike'],
                ['hr', 'quote'],
                ['ul', 'ol', 'task'],
                ['table', 'image', 'link'],
                ['code', 'codeblock'],
                [{
                    el: flickrButton,
                    command: 'flickr',
                    tooltip: '插入 Flickr 相簿'
                }]
            ]
        });
    }
    
    function insertFlickrAlbum() {
        const url = prompt('請輸入 Flickr 相簿或相片網址:\n(例如: https://www.flickr.com/photos/user/albums/12345)');
        if (!url) return;
        const embedCode = `<a data-flickr-embed="true" href="${url}" title="Flickr Album (Click to view)">[Flickr Album]</a><script async src="//embedr.flickr.com/assets/client-code.js" charset="utf-8"><\/script>`;
        editor.exec('htmlBlock', { html: embedCode });
    }

    // --- API Helpers ---
    function getHeaders() {
        return {
            'Content-Type': 'application/json',
            'X-Auth-Password': (els.authPassword && els.authPassword.value) || localStorage.getItem('editor_password')
        };
    }

    function showLoading(show) {
        if (els.loading) els.loading.style.display = show ? 'flex' : 'none';
    }

    // --- Core Logic ---
    async function loadPosts() {
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts`, { headers: getHeaders() });
            if (res.status === 401) {
                alert('密碼錯誤');
                showLoading(false);
                return;
            }
            if (!res.ok) throw new Error('Failed to fetch');
            
            allPosts = await res.json();
            renderList(allPosts);
        } catch (err) {
            console.error(err);
        }
        showLoading(false);
    }

    function renderList(posts) {
        if (!els.postList) return;
        els.postList.innerHTML = posts.map(post => `
            <div class="post-item ${currentSlug === post.slug ? 'active' : ''}" onclick="selectPost('${post.slug}')">
                <span class="post-title">${post.title}</span>
                <span class="post-meta">${post.date || '--'}</span>
            </div>
        `).join('');
    }

    window.selectPost = async function(slug) {
        currentSlug = slug;
        showView('editor');
        showLoading(true);
        
        try {
            const res = await fetch(`${API_BASE}/api/posts/${slug}`, { headers: getHeaders() });
            
            if (res.status === 401) {
                alert('密碼錯誤或未輸入，請在上方重新輸入密碼。');
                showLoading(false);
                return;
            }
            
            if (!res.ok) {
                throw new Error(`API Error: ${res.status}`);
            }

            const data = await res.json();
            
            if (!data.slug || data.content === undefined) {
                 throw new Error('Invalid Data format received');
            }
            
            if (els.postSlug) els.postSlug.value = data.slug;
            if (editor) {
                // Ensure content is a string
                editor.setMarkdown(String(data.content));
                if (typeof editor.setScrollTop === 'function') {
                    editor.setScrollTop(0);
                } else if (typeof editor.scrollTop === 'function') {
                    editor.scrollTop(0);
                }
            }
            renderList(allPosts);
            
             // Mobile check
            if (window.innerWidth < 768 && els.sidebar) {
                els.sidebar.classList.add('collapsed');
            }
            
        } catch (err) {
            console.error(err);
            alert(`載入失敗: ${err.message}`);
        }
        showLoading(false);
    }
    
    function showView(viewName) {
        if (els.editorView) els.editorView.style.display = 'none';
        if (els.emptyState) els.emptyState.style.display = 'none';
        if (els.newPostView) els.newPostView.style.display = 'none';
        if (els.actionButtons) els.actionButtons.style.display = 'none';
        
        if (viewName === 'editor') {
            if (els.editorView) {
                els.editorView.style.display = 'flex';
                els.editorView.style.flexDirection = 'column';
                els.editorView.style.flex = '1';
            }
            if (els.actionButtons) els.actionButtons.style.display = 'flex';
        } else if (viewName === 'new') {
            if (els.newPostView) els.newPostView.style.display = 'block';
            currentSlug = null;
            renderList(allPosts);
        } else {
            if (els.emptyState) els.emptyState.style.display = 'flex';
            currentSlug = null;
            renderList(allPosts);
        }
    }

    // --- Actions ---
    async function savePost() {
        if (!currentSlug) return;
        showLoading(true);
        try {
            const content = editor.getMarkdown();
            const res = await fetch(`${API_BASE}/api/posts/${currentSlug}`, {
                method: 'PUT',
                headers: getHeaders(),
                body: JSON.stringify({ content })
            });
            const result = await res.json();
            
            if (result.success) {
                const msg = result.deploying ? '儲存成功！正在自動部署...' : '儲存成功';
                alert(msg);
                loadPosts();
            } else {
                alert('失敗: ' + result.error);
            }
        } catch (err) {
            alert('連線失敗');
        }
        showLoading(false);
    }

    async function textCreatePost() {
        const title = els.newTitle.value.trim();
        const category = els.newCategory.value;
        const customSlug = els.newSlug.value.trim();
        
        if (!title) { alert('請輸入標題'); return; }
        
        showLoading(true);
        try {
            const payload = { title, category, slug: customSlug };
            const res = await fetch(`${API_BASE}/api/posts`, {
                method: 'POST',
                headers: getHeaders(),
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            
            if (result.success) {
                const msg = result.deploying ? '文章建立成功！正在自動部署...' : '文章建立成功';
                alert(msg);
                if (els.newTitle) els.newTitle.value = '';
                if (els.newSlug) els.newSlug.value = '';
                await loadPosts();
                if (result.slug) {
                    selectPost(result.slug);
                } else {
                    showView('empty');
                }
            } else {
                alert('建立失敗: ' + result.error);
            }
        } catch (err) {
            console.error(err);
            alert('連線失敗');
        }
        showLoading(false);
    }
    
    async function deletePost() {
        if (!currentSlug || !confirm('確定要刪除這篇文章嗎？此動作無法復原。')) return;
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts/${currentSlug}`, { 
                method: 'DELETE', headers: getHeaders() 
            });
            const result = await res.json();
            if (result.success) {
                alert('刪除成功');
                showView('empty');
                loadPosts();
            } else {
                alert('刪除失敗');
            }
        } catch (err) {
            alert('連線失敗');
        }
        showLoading(false);
    }

    // --- Authentication ---
    function handleLogin() {
        if (els.authPassword && !els.authPassword.value) { alert('請輸入密碼'); return; }
        if (els.authPassword) localStorage.setItem('editor_password', els.authPassword.value);
        loadPosts();
    }
</script>
