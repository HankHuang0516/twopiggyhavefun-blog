---
import Layout from '../layouts/Layout.astro';
---

<Layout title="文章編輯器 | TwoPiggyHaveFun">
    <!-- Toast UI Editor CSS -->
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css" />
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/theme/toastui-editor-dark.min.css" />
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <div id="loading" class="loading-overlay">
        <div>載入中...</div>
    </div>

    <div class="editor-wrapper">
        <header class="editor-header-nav">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <button id="sidebar-toggle" class="icon-btn" title="切換側邊欄">
                    <i class="ph ph-list" style="font-size: 1.5rem;"></i>
                </button>
                <h1>📝 文章管理系統</h1>
            </div>
            
            <div class="controls">
                <div class="auth-container">
                    <div class="password-wrapper">
                        <input type="password" id="auth-password" class="auth-box" placeholder="輸入密碼...">
                        <button id="toggle-password" class="icon-btn-small" title="顯示密碼">
                            <i class="ph ph-eye"></i>
                        </button>
                    </div>
                    <button class="btn btn-primary" id="auth-btn">確認</button>
                </div>
                
                <div class="divider"></div>

                <div id="action-buttons" style="display: none; gap: 0.5rem;">
                   <button class="btn btn-primary" id="save-btn">
                        <i class="ph ph-floppy-disk"></i> 儲存
                    </button>
                    <button class="btn btn-danger" id="delete-btn">
                        <i class="ph ph-trash"></i> 刪除
                    </button>
                </div>

                <button class="btn btn-secondary" id="new-post-btn">+ 新增文章</button>
            </div>
        </header>

        <div class="main-container">
            <div id="sidebar" class="sidebar">
                <div class="sidebar-header">
                    <input type="text" id="search-input" class="search-box" placeholder="搜尋標題...">
                </div>
                <div id="post-list" class="post-list">
                    <!-- Posts will be loaded here -->
                </div>
            </div>

            <div class="editor-area">
                <div id="editor-view" style="display: none; flex-direction: column; height: 100%;">
                    <div class="editor-field slug-field">
                        <span class="label">Slug:</span>
                        <input type="text" id="post-slug" disabled>
                    </div>

                    <div id="toast-editor-container" style="flex: 1;"></div>
                </div>
                
                <div id="empty-state" style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #64748b; gap: 1rem;">
                    <i class="ph ph-article" style="font-size: 4rem; opacity: 0.5;"></i>
                    <p>請從左側選擇文章進行編輯</p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    :root {
        --primary: #2563eb;
        --danger: #ef4444; 
        --border: #e2e8f0;
        --bg-light: #f8fafc;
        --text-main: #1e293b;
        --text-sub: #64748b;
    }

    body { margin: 0; overflow: hidden; }

    .loading-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(255,255,255,0.8); display: none;
        justify-content: center; align-items: center; z-index: 9999; font-weight: bold;
    }
    
    .editor-wrapper {
        display: flex; flex-direction: column;
        height: 100vh; background: var(--bg-light);
    }

    .editor-header-nav {
        background: white; border-bottom: 1px solid var(--border); padding: 0.75rem 1.5rem;
        display: flex; justify-content: space-between; align-items: center;
        height: 60px; box-sizing: border-box;
    }

    .editor-header-nav h1 { font-size: 1.1rem; margin: 0; color: var(--text-main); }

    .main-container { display: flex; flex: 1; overflow: hidden; position: relative; }

    /* Sidebar */
    .sidebar { 
        width: 300px; background: white; border-right: 1px solid var(--border); 
        display: flex; flex-direction: column; transition: transform 0.3s ease, width 0.3s ease;
        flex-shrink: 0;
    }

    .sidebar.collapsed {
        transform: translateX(-300px);
        width: 0; border: none;
    }

    .sidebar-header { padding: 1rem; border-bottom: 1px solid var(--border); }
    
    .search-box { 
        width: 100%; padding: 0.5rem; border: 1px solid var(--border); 
        border-radius: 6px; box-sizing: border-box; font-size: 0.9rem;
    }

    .post-list { flex: 1; overflow-y: auto; }
    
    .post-item { 
        padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); 
        cursor: pointer; transition: background 0.1s;
    }
    
    .post-item:hover { background: #f1f5f9; }
    
    .post-item.active { 
        background: #eff6ff; border-left: 3px solid var(--primary);
    }
    
    .post-title { 
        font-weight: 500; margin-bottom: 0.25rem; display: block; 
        color: var(--text-main); font-size: 0.95rem;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    
    .post-meta { font-size: 0.8rem; color: var(--text-sub); }

    /* Editor Area */
    .editor-area { 
        flex: 1; display: flex; flex-direction: column; 
        padding: 1.5rem; background: var(--bg-light); 
        overflow: hidden; 
    }

    .slug-field {
        display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;
        background: white; padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid var(--border);
    }

    .slug-field .label { font-size: 0.85rem; color: var(--text-sub); font-weight: 600; }
    
    .slug-field input { 
        border: none; background: transparent; flex: 1; 
        color: var(--text-main); font-family: monospace; font-size: 0.9rem;
    }

    /* Controls */
    .controls { display: flex; gap: 1rem; align-items: center; }
    
    .divider { width: 1px; height: 24px; background: var(--border); }

    .auth-container { display: flex; gap: 0.5rem; align-items: center; }
    
    .password-wrapper { position: relative; display: flex; align-items: center; }
    .auth-box { 
        width: 140px; padding: 0.5rem; padding-right: 2rem;
        border: 1px solid var(--border); border-radius: 6px; 
    }
    
    .icon-btn, .icon-btn-small {
        background: none; border: none; cursor: pointer; color: var(--text-sub);
        display: flex; align-items: center; justify-content: center;
        border-radius: 4px; transition: background 0.2s;
    }

    .icon-btn:hover { background: #f1f5f9; color: var(--text-main); }
    
    .icon-btn-small {
        position: absolute; right: 4px; padding: 4px;
    }

    .btn { 
        padding: 0.5rem 1rem; border-radius: 6px; font-weight: 500; cursor: pointer; 
        border: none; transition: opacity 0.2s; display: flex; align-items: center; gap: 0.4rem;
        font-size: 0.9rem;
    }
    
    .btn:hover { opacity: 0.9; }
    .btn-primary { background: var(--primary); color: white; }
    .btn-danger { background: var(--danger); color: white; }
    .btn-secondary { background: white; border: 1px solid var(--border); color: var(--text-main); }

    /* Toast UI Customization */
    .toastui-editor-defaultUI { 
        border: 1px solid var(--border) !important; 
        border-radius: 6px; 
        background: white;
    }
    .toastui-editor-defaultUI .toastui-editor-md-container,
    .toastui-editor-defaultUI .toastui-editor-ww-container {
        border-radius: 0 0 6px 6px;
    }
</style>

<!-- Toast UI Editor JS -->
<script is:inline src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

<script is:inline>
    // Config
    const RAILWAY_API = 'https://twopiggyhavefun-blog-production.up.railway.app';
    const isLocalDev = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
    const API_BASE = isLocalDev ? 'http://localhost:3456' : RAILWAY_API;
    
    let currentSlug = null;
    let allPosts = [];
    let editor = null;
    let isSidebarOpen = true;

    // Elements
    const views = {
        editor: document.getElementById('editor-view'),
        empty: document.getElementById('empty-state'),
        actions: document.getElementById('action-buttons')
    };
    
    // Initialize Toast UI
    function initEditor() {
        // @ts-ignore
        const Editor = toastui.Editor;
        editor = new Editor({
            el: document.querySelector('#toast-editor-container'),
            height: '100%',
            minHeight: '400px',
            initialEditType: 'wysiwyg',
            previewStyle: 'vertical',
            language: 'zh-TW',
            theme: 'light',
            initialValue: ' ',
            usageStatistics: false,
            toolbarItems: [
                ['heading', 'bold', 'italic', 'strike'],
                ['hr', 'quote'],
                ['ul', 'ol', 'task', 'indent', 'outdent'],
                ['table', 'image', 'link'],
                ['code', 'codeblock']
            ]
        });
    }

    // UI Toggles
    document.getElementById('sidebar-toggle').addEventListener('click', () => {
        isSidebarOpen = !isSidebarOpen;
        const sidebar = document.getElementById('sidebar');
        if (isSidebarOpen) sidebar.classList.remove('collapsed');
        else sidebar.classList.add('collapsed');
    });

    document.getElementById('toggle-password').addEventListener('click', (e) => {
        const input = document.getElementById('auth-password');
        const icon = e.currentTarget.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('ph-eye', 'ph-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('ph-eye-slash', 'ph-eye');
        }
    });

    // API & Logic (Reused from previous version but adapted for new UI)
    const authPasswordInput = document.getElementById('auth-password');
    
    function getHeaders() {
        return {
            'Content-Type': 'application/json',
            'X-Auth-Password': authPasswordInput.value || localStorage.getItem('editor_password')
        };
    }

    function handleLogin() {
        if (!authPasswordInput.value) return alert('請輸入密碼');
        localStorage.setItem('editor_password', authPasswordInput.value);
        loadPosts();
    }

    document.getElementById('auth-btn').addEventListener('click', handleLogin);
    authPasswordInput.addEventListener('keydown', (e) => { if(e.key === 'Enter') handleLogin() });
    
    if (localStorage.getItem('editor_password')) {
        authPasswordInput.value = localStorage.getItem('editor_password');
    }

    async function loadPosts() {
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts`, { headers: getHeaders() });
            if (res.status === 401) { alert('密碼錯誤'); showLoading(false); return; }
            allPosts = await res.json();
            renderList(allPosts);
        } catch (err) {
            console.error(err);
        }
        showLoading(false);
    }

    function renderList(posts) {
        document.getElementById('post-list').innerHTML = posts.map(post => `
            <div class="post-item ${currentSlug === post.slug ? 'active' : ''}" onclick="selectPost('${post.slug}')">
                <span class="post-title">${post.title}</span>
                <span class="post-meta">${post.date || '--'}</span>
            </div>
        `).join('');
    }

    window.selectPost = async function(slug) {
        currentSlug = slug;
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts/${slug}`, { headers: getHeaders() });
            const data = await res.json();
            
            document.getElementById('post-slug').value = data.slug;
            if (editor) {
                editor.setMarkdown(data.content);
                editor.changeMode('wysiwyg');
                editor.scrollTop(0);
            }
            
            views.editor.style.display = 'flex';
            views.empty.style.display = 'none';
            views.actions.style.display = 'flex';
            renderList(allPosts);
        } catch (err) {
            alert('載入失敗');
        }
        showLoading(false);
    }

    async function savePost() {
        if (!currentSlug) return;
        showLoading(true);
        try {
            const content = editor.getMarkdown();
            const res = await fetch(`${API_BASE}/api/posts/${currentSlug}`, {
                method: 'PUT',
                headers: getHeaders(),
                body: JSON.stringify({ content })
            });
            const result = await res.json();
            if (result.success) {
                const msg = result.deploying ? '儲存成功！正在自動部署...' : '儲存成功';
                // Use a non-blocking notification if possible, but alert matches existing behavior
                alert(msg);
                loadPosts();
            } else {
                alert('失敗: ' + result.error);
            }
        } catch (err) {
            alert('連線失敗');
        }
        showLoading(false);
    }

    async function deletePost() {
        if (!currentSlug || !confirm('確定刪除？')) return;
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts/${currentSlug}`, { 
                method: 'DELETE', headers: getHeaders() 
            });
            const result = await res.json();
            if (result.success) {
                alert('刪除成功');
                currentSlug = null;
                views.editor.style.display = 'none';
                views.empty.style.display = 'flex';
                views.actions.style.display = 'none';
                loadPosts();
            }
        } catch (err) {
            alert('刪除失敗');
        }
        showLoading(false);
    }

    function showLoading(show) {
        document.getElementById('loading').style.display = show ? 'flex' : 'none';
    }

    document.getElementById('save-btn').addEventListener('click', savePost);
    document.getElementById('delete-btn').addEventListener('click', deletePost);
    document.getElementById('search-input').addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase();
        renderList(allPosts.filter(p => p.title.toLowerCase().includes(q)));
    });

    window.onload = function() {
        initEditor();
        loadPosts();
    };
</script>
    <!-- Toast UI Editor CSS -->
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css" />
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/theme/toastui-editor-dark.min.css" />

    <div id="loading" class="loading-overlay">
        <div>載入中...</div>
    </div>

    <div class="editor-wrapper">
        <header class="editor-header-nav">
            <h1>📝 文章管理系統</h1>
            <div class="controls">
                <div class="auth-container">
                    <input type="password" id="auth-password" class="auth-box" placeholder="輸入密碼...">
                    <button class="btn btn-primary" id="auth-btn">確認</button>
                </div>
                <button class="btn btn-primary" id="new-post-btn">+ 新增文章</button>
                <button class="btn btn-primary" id="deploy-btn">🚀 部署網站</button>
            </div>
        </header>

        <div class="main-container">
            <div class="sidebar">
                <div class="sidebar-header">
                    <input type="text" id="search-input" class="search-box" placeholder="搜尋標題...">
                </div>
                <div id="post-list" class="post-list">
                    <!-- Posts will be loaded here -->
                </div>
            </div>

            <div class="editor-area">
                <div id="editor-view" style="display: none;">
                    <div class="editor-title-container">
                        <h2 id="editor-title-display">編輯文章</h2>
                    </div>
                    
                    <div class="editor-field">
                        <label>檔案名稱 (Slug)</label>
                        <input type="text" id="post-slug" disabled>
                    </div>

                    <div id="toast-editor-container" style="flex: 1; margin-bottom: 1rem;"></div>

                    <div class="controls" style="margin-top: 1rem;">
                        <button class="btn btn-primary" id="save-btn">儲存修改</button>
                        <button class="btn btn-danger" id="delete-btn">刪除文章</button>
                    </div>
                </div>
                
                <div id="empty-state" style="flex: 1; display: flex; justify-content: center; align-items: center; color: #64748b;">
                    <p>請從左側選擇文章進行編輯，或點擊「新增文章」</p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    .auth-container { display: flex; gap: 0.25rem; }
    .loading-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(255,255,255,0.8); display: none;
        justify-content: center; align-items: center; z-index: 9999; font-weight: bold;
    }
    .editor-wrapper {
        display: flex; flex-direction: column;
        height: calc(100vh - 64px); background: #f8fafc;
    }
    .editor-header-nav {
        background: white; border-bottom: 1px solid #e2e8f0; padding: 1rem 2rem;
        display: flex; justify-content: space-between; align-items: center;
    }
    .editor-header-nav h1 { font-size: 1.25rem; margin: 0; }
    .main-container { display: flex; flex: 1; overflow: hidden; }
    .sidebar { width: 320px; background: white; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column; }
    .sidebar-header { padding: 1rem; border-bottom: 1px solid #e2e8f0; }
    .search-box, .auth-box { width: 100%; padding: 0.5rem; border: 1px solid #e2e8f0; border-radius: 4px; box-sizing: border-box; }
    .auth-box { width: 150px; margin-right: 1rem; }
    .post-list { flex: 1; overflow-y: auto; }
    .post-item { padding: 1rem; border-bottom: 1px solid #e2e8f0; cursor: pointer; transition: background 0.2s; }
    .post-item:hover { background: #f1f5f9; }
    .post-item.active { background: #eff6ff; border-left: 4px solid #2563eb; }
    .post-title { font-weight: 600; margin-bottom: 0.25rem; display: block; color: #1e293b; }
    .post-meta { font-size: 0.8rem; color: #64748b; }
    .editor-area { flex: 1; display: flex; flex-direction: column; padding: 2rem; background: white; overflow-y: auto; }
    .editor-field { margin-bottom: 1rem; }
    .editor-field label { display: block; font-size: 0.875rem; font-weight: 600; color: #64748b; margin-bottom: 0.5rem; }
    .editor-field input { width: 100%; padding: 0.75rem; border: 1px solid #e2e8f0; border-radius: 4px; background: #f8fafc; }
    .btn { padding: 0.625rem 1.25rem; border-radius: 4px; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s; }
    .btn-primary { background: #2563eb; color: white; }
    .btn-danger { background: #ef4444; color: white; }
    .controls { display: flex; gap: 0.5rem; align-items: center; }
    
    /* Toast UI Fixes */
    .toastui-editor-defaultUI { border: 1px solid #e2e8f0 !important; border-radius: 4px; }
</style>

<!-- Toast UI Editor JS -->
<script is:inline src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

<script is:inline>
    // Configuration - Dynamic backend selection
    const RAILWAY_API = 'https://twopiggyhavefun-blog-production.up.railway.app';
    const isLocalDev = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
    const API_BASE = isLocalDev ? 'http://localhost:3456' : RAILWAY_API;
    
    let currentSlug = null;
    let allPosts = [];
    let editor = null;

    // Elements
    const postListEl = document.getElementById('post-list');
    const searchInput = document.getElementById('search-input');
    const authPasswordInput = document.getElementById('auth-password');
    const editorView = document.getElementById('editor-view');
    const emptyState = document.getElementById('empty-state');
    const slugInput = document.getElementById('post-slug');
    const loading = document.getElementById('loading');
    const authBtn = document.getElementById('auth-btn');

    // Initialize Toast UI Editor
    function initEditor() {
        // @ts-ignore
        const Editor = toastui.Editor;
        editor = new Editor({
            el: document.querySelector('#toast-editor-container'),
            height: '600px',
            initialEditType: 'wysiwyg', // Default to Visual mode
            previewStyle: 'vertical',
            language: 'zh-TW',
            theme: 'light', // Can be toggled to 'dark'
            initialValue: ' ',
            usageStatistics: false
        });
    }

    // Helper to get headers
    function getHeaders() {
        return {
            'Content-Type': 'application/json',
            'X-Auth-Password': authPasswordInput.value || localStorage.getItem('editor_password')
        };
    }

    // Save password to local storage and load
    function handleLogin() {
        if (!authPasswordInput.value) {
            alert('請輸入密碼');
            return;
        }
        localStorage.setItem('editor_password', authPasswordInput.value);
        loadPosts();
    }

    authBtn.addEventListener('click', handleLogin);
    
    authPasswordInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handleLogin();
    });

    if (localStorage.getItem('editor_password')) {
        authPasswordInput.value = localStorage.getItem('editor_password');
    }

    async function loadPosts() {
        showLoading(true);
        try {
            const url = `${API_BASE}/api/posts`;
            const res = await fetch(url, { headers: getHeaders() });
            const text = await res.text();
            
            if (res.status === 401) {
                alert('密碼錯誤或未輸入');
                showLoading(false);
                return;
            }
            
            try {
                allPosts = JSON.parse(text);
                renderList(allPosts);
            } catch (jsonErr) {
                console.error('JSON Parse Error:', jsonErr, 'Raw Content:', text);
                alert(`API 回傳格式錯誤。\n${text.substring(0, 200)}...`);
            }
        } catch (err) {
            console.error('API Error:', err);
            alert(`無法連線至後端 API (${API_BASE})。\n錯誤：${err.message}`);
        }
        showLoading(false);
    }

    function renderList(posts) {
        postListEl.innerHTML = posts.map(post => `
            <div class="post-item ${currentSlug === post.slug ? 'active' : ''}" onclick="selectPost('${post.slug}')">
                <span class="post-title">${post.title}</span>
                <span class="post-meta">${post.date || '無日期'} | ${post.category}</span>
            </div>
        `).join('');
    }

    window.selectPost = async function(slug) {
        currentSlug = slug;
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts/${slug}`, { headers: getHeaders() });
            if (res.status === 401) {
                alert('密碼驗證失敗');
                showLoading(false);
                return;
            }
            const data = await res.json();
            
            slugInput.value = data.slug;
            
            // Set content to Editor
            if (editor) {
                editor.setMarkdown(data.content);
                // Switch to WYSIWYG mode explicitly if needed
                editor.changeMode('wysiwyg');
            }
            
            editorView.style.display = 'flex';
            emptyState.style.display = 'none';
            renderList(allPosts);
        } catch (err) {
            alert('載入文章失敗: ' + err.message);
        }
        showLoading(false);
    }

    async function savePost() {
        if (!currentSlug) return;
        
        // Get content from Editor
        const content = editor.getMarkdown();

        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts/${currentSlug}`, {
                method: 'PUT',
                headers: getHeaders(),
                body: JSON.stringify({ content: content })
            });
            if (res.status === 401) {
                alert('密碼錯誤，無法儲存');
                showLoading(false);
                return;
            }
            const result = await res.json();
            if (result.success) {
                const msg = result.deploying
                    ? '文章已儲存！正在自動部署，請稍候幾分鐘讓網站更新。'
                    : '文章已儲存（自動部署未啟用）';
                alert(msg);
                loadPosts();
            } else {
                alert('儲存失敗: ' + result.error);
            }
        } catch (err) {
            alert('連線失敗');
        }
        showLoading(false);
    }

    async function deletePost() {
        if (!currentSlug || !confirm('確定要刪除這篇文章嗎？此動作無法復原。')) return;
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts/${currentSlug}`, { 
                method: 'DELETE',
                headers: getHeaders()
            });
            if (res.status === 401) {
                alert('密碼錯誤，無法刪除');
                showLoading(false);
                return;
            }
            const result = await res.json();
            if (result.success) {
                const msg = result.deploying
                    ? '文章已刪除！正在自動部署，請稍候幾分鐘讓網站更新。'
                    : '文章已刪除（自動部署未啟用）';
                alert(msg);
                currentSlug = null;
                editorView.style.display = 'none';
                emptyState.style.display = 'flex';
                loadPosts();
            }
        } catch (err) {
            alert('刪除失敗');
        }
        showLoading(false);
    }

    async function triggerDeploy() {
        if (!confirm('即將推送改動並重新編譯網站，確定嗎？')) return;
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/deploy`, { 
                method: 'POST',
                headers: getHeaders()
            });
            if (res.status === 401) {
                alert('密碼錯誤，無法部署');
                showLoading(false);
                return;
            }
            const result = await res.json();
            if (result.success) {
                alert('部署已觸發！請等待幾分鐘讓網站更新。');
            } else {
                alert('部署失敗: ' + result.error);
            }
        } catch (err) {
            alert('部署連線失敗');
        }
        showLoading(false);
    }

    function showLoading(show) {
        loading.style.display = show ? 'flex' : 'none';
    }

    // Event Listeners
    document.getElementById('save-btn').addEventListener('click', savePost);
    document.getElementById('delete-btn').addEventListener('click', deletePost);
    document.getElementById('deploy-btn').addEventListener('click', triggerDeploy);
    
    searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        const filtered = allPosts.filter(p => p.title.toLowerCase().includes(query));
        renderList(filtered);
    });

    document.getElementById('new-post-btn').addEventListener('click', () => {
        alert('新增文章功能請繼續使用現有的 API 或自動同步機制，此介面優先提供修改與刪除。');
    });

    // Bootstrap
    window.onload = function() {
        initEditor();
        loadPosts();
    };
</script>

