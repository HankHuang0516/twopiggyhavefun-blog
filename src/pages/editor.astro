---
import Layout from '../layouts/Layout.astro';
---

<Layout title="文章編輯器 | TwoPiggyHaveFun">
    <!-- Toast UI Editor CSS -->
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css" />
    <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/theme/toastui-editor-dark.min.css" />
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <div id="loading" class="loading-overlay">
        <div>載入中...</div>
    </div>

    <!-- Login View (Default) -->
    <div id="login-view" class="login-view">
        <div class="login-card">
            <h2>🔐 管理員登入</h2>
            <p style="color: #666; margin-bottom: 1.5rem;">請輸入密碼以進入文章管理系統</p>
            <div class="form-group">
                <input type="password" id="login-password" class="input-clean" placeholder="輸入密碼..." style="text-align: center;">
            </div>
            <button id="login-btn" class="btn btn-primary" style="width: 100%; justify-content: center;">登入系統</button>
        </div>
    </div>

    <!-- Flickr Picker Modal -->
    <div id="flickr-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>選擇 Flickr 相片</h3>
                <button id="close-flickr-modal" class="icon-btn"><i class="ph ph-x"></i></button>
            </div>
            <div class="modal-tabs">
                <button class="tab-btn active" data-tab="recent">最近上傳</button>
                <button class="tab-btn" data-tab="albums">相簿</button>
            </div>
            <div class="modal-body">
                <div id="flickr-grid" class="flickr-grid">
                    <!-- Photos will load here -->
                </div>
                <!-- Sub-view for Album Photos -->
                <div id="flickr-album-view" style="display: none;">
                    <button id="back-to-albums" class="btn btn-secondary" style="margin-bottom: 1rem;">NO_ICON 回上一層</button>
                    <div id="flickr-album-grid" class="flickr-grid"></div>
                </div>
            </div>
            <div class="modal-footer">
               <span id="flickr-status" style="color: #666; font-size: 0.9rem;"></span>
            </div>
        </div>
    </div>

    <!-- Main App (Hidden by default) -->
    <div id="app-container" style="display: none;">
        <div class="editor-wrapper">
            <header class="editor-header-nav">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <button id="sidebar-toggle" class="icon-btn" title="切換側邊欄">
                        <i class="ph ph-list" style="font-size: 1.5rem;"></i>
                    </button>
                    <h1>📝 文章管理系統</h1>
                </div>
                
                <div class="controls">
                    <!-- Action Buttons -->
                    <div id="action-buttons" style="display: none; gap: 0.5rem;">
                       <button class="btn btn-primary" id="save-btn">
                            <i class="ph ph-floppy-disk"></i> 儲存
                        </button>
                        <button class="btn btn-danger" id="delete-btn">
                            <i class="ph ph-trash"></i> 刪除
                        </button>
                    </div>

                    <button class="btn btn-secondary" id="new-post-btn">+ 新增文章</button>

                    <button class="btn btn-secondary" id="logout-btn" title="登出">
                        <i class="ph ph-sign-out"></i>
                    </button>
                </div>
            </header>

            <div class="main-container">
                <div id="sidebar" class="sidebar">
                    <div class="sidebar-header" style="justify-content: space-between;">
                        <input type="text" id="search-input" class="search-box" placeholder="搜尋標題..." style="flex:1; margin-right:0.5rem;">
                         <button id="sidebar-close-btn" class="icon-btn-small" title="收合選單">
                            <i class="ph ph-caret-left"></i>
                        </button>
                    </div>
                    <div id="post-list" class="post-list">
                        <!-- Posts will be loaded here -->
                    </div>
                </div>

                <div class="editor-area">
                    <!-- Editor View -->
                    <div id="editor-view" style="display: none;">
                        
                        <!-- Metadata Fields (Integrated) -->
                        <div class="editor-metadata" style="display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
                             <div style="flex: 2; min-width: 200px;">
                                <label style="display:block; font-size:0.8rem; color:#666; margin-bottom:0.25rem;">文章標題 *</label>
                                <input type="text" id="post-title-input" class="input-clean" placeholder="輸入文章標題...">
                             </div>
                             <div style="flex: 1; min-width: 150px;">
                                <label style="display:block; font-size:0.8rem; color:#666; margin-bottom:0.25rem;">分類 *</label>
                                <select id="post-category-input" class="input-clean">
                                    <optgroup label="台北">
                                        <option value="taipei-food">台北美食</option>
                                        <option value="taipei-attractions">台北景點</option>
                                    </optgroup>
                                    <optgroup label="新北">
                                        <option value="newtaipei-food">新北美食</option>
                                        <option value="newtaipei-attractions">新北景點</option>
                                    </optgroup>
                                    <optgroup label="桃園">
                                        <option value="taoyuan-food">桃園美食</option>
                                        <option value="taoyuan-attractions">桃園景點</option>
                                    </optgroup>
                                    <optgroup label="其他地區">
                                        <option value="hsinchu-food">新竹美食</option>
                                        <option value="hsinchu-attractions">新竹景點</label>
                                        <option value="taichung-food">台中美食</option>
                                        <option value="taichung-attractions">台中景點</option>
                                        <option value="tainan-food">台南美食</option>
                                        <option value="tainan-attractions">台南景點</option>
                                        <option value="kaohsiung-food">高雄美食</option>
                                        <option value="kaohsiung-attractions">高雄景點</option>
                                        <option value="yilan-food">宜蘭美食</option>
                                        <option value="yilan-attractions">宜蘭景點</option>
                                    </optgroup>
                                    <optgroup label="其他">
                                        <option value="life">生活雜記</option>
                                        <option value="uncategorized">未分類</option>
                                    </optgroup>
                                </select>
                             </div>
                             <div style="flex: 1; min-width: 150px;">
                                 <label style="display:block; font-size:0.8rem; color:#666; margin-bottom:0.25rem;">自訂網址 (Slug)</label>
                                 <input type="text" id="post-slug-input" class="input-clean" placeholder="留空自動產生">
                             </div>
                        </div>

                        <div id="toast-editor-container" style="flex: 1 1 0%; margin-bottom: 1rem; height: 100%;"></div>
                    </div>
                    
                    <!-- Empty State -->
                    <div id="empty-state" style="flex: 1 1 0%; display: flex; justify-content: center; align-items: center; color: rgb(100, 116, 139);">
                        <p>請從左側選擇文章進行編輯，或點擊「新增文章」</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    :root {
        --primary: #2563eb;
        --danger: #ef4444;
        --bg-light: #f8fafc;
        --border: #e2e8f0;
        --text-main: #1e293b;
        --text-muted: #64748b;
    }
    
    body { margin: 0; font-family: 'Inter', sans-serif; }
    
    .loading-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(255,255,255,0.8); display: none;
        justify-content: center; align-items: center; z-index: 9999; font-weight: bold;
    }

    /* Login View Styles */
    .login-view {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: #f1f5f9; display: flex;
        justify-content: center; align-items: center; z-index: 5000;
    }
    .login-card {
        background: white; padding: 2rem; border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        width: 100%; max-width: 320px; text-align: center;
    }
    .login-card h2 { margin-top: 0; color: var(--text-main); }
    
    /* Flickr Modal Styles */
    .modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.5); z-index: 2000;
        display: flex; justify-content: center; align-items: center;
    }
    .modal-content {
        background: white; width: 90%; max-width: 800px; height: 80vh;
        border-radius: 8px; display: flex; flex-direction: column;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }
    .modal-header {
        padding: 1rem; border-bottom: 1px solid var(--border);
        display: flex; justify-content: space-between; align-items: center;
    }
    .modal-header h3 { margin: 0; font-size: 1.1rem; }
    
    .modal-tabs { display: flex; border-bottom: 1px solid var(--border); }
    .tab-btn {
        padding: 0.75rem 1.5rem; background: none; border: none; cursor: pointer;
        font-weight: 500; color: var(--text-muted); border-bottom: 2px solid transparent;
    }
    .tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }
    
    .modal-body { flex: 1; overflow-y: auto; padding: 1rem; background: #fafafa; }
    .flickr-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem;
    }
    .flickr-item, .album-item {
        background: white; border: 1px solid var(--border); border-radius: 4px; 
        overflow: hidden; cursor: pointer; transition: transform 0.2s;
        aspect-ratio: 1; position: relative;
    }
    .flickr-item:hover, .album-item:hover { transform: translateY(-2px); box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .flickr-item img, .album-item img { width: 100%; height: 100%; object-fit: cover; }
    .album-title {
        position: absolute; bottom: 0; left: 0; right: 0; 
        background: rgba(0,0,0,0.7); color: white; padding: 0.5rem; 
        font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    
    .modal-footer { padding: 0.75rem 1rem; border-top: 1px solid var(--border); text-align: right; }

    .editor-wrapper {
        display: flex; flex-direction: column;
        min-height: 100vh; background: var(--bg-light);
    }
    .editor-header-nav {
        background: white; border-bottom: 1px solid var(--border); padding: 0.75rem 1.5rem;
        display: flex; justify-content: space-between; align-items: center;
        height: 64px; box-sizing: border-box;
        position: sticky; top: 0; z-index: 100;
    }
    .editor-header-nav h1 { font-size: 1.25rem; margin: 0; color: var(--text-main); }
    
    .controls { display: flex; align-items: center; gap: 1rem; }
    
    .icon-btn, .icon-btn-small { 
        background: none; border: none; cursor: pointer; color: var(--text-muted); 
        padding: 0.5rem; border-radius: 4px; transition: all 0.2s; display: flex; align-items: center; justify-content: center;
    }
    .icon-btn-small { padding: 0.25rem; }
    .icon-btn:hover, .icon-btn-small:hover { background: #f1f5f9; color: var(--primary); }
    
    .divider { width: 1px; height: 24px; background: var(--border); margin: 0 0.5rem; }
    
    .main-container { display: flex; flex: 1; position: relative; }
    .sidebar { 
        width: 300px; background: white; border-right: 1px solid var(--border); 
        display: flex; flex-direction: column; transition: margin-left 0.3s ease;
        position: fixed; top: 0; bottom: 0; z-index: 2000;
    }
    .main-container.sidebar-open { padding-left: 300px; }
    .sidebar.collapsed { transform: translateX(-100%); }
    
    .sidebar-header { 
        padding: 1rem; border-bottom: 1px solid var(--border); 
        background: white; position: relative; z-index: 10;
    }
    .search-box, .auth-box { 
        width: 100%; padding: 0.5rem; border: 1px solid var(--border); 
        border-radius: 4px; box-sizing: border-box; outline: none;
    }
    .search-box:focus, .auth-box:focus { border-color: var(--primary); }
    .auth-box { width: 140px; }
    
    .post-list { flex: 1; overflow-y: auto; }
    .post-item { padding: 1rem; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.2s; }
    .post-item:hover { background: #f1f5f9; }
    .post-item.active { background: #eff6ff; border-left: 4px solid var(--primary); }
    .post-title { font-weight: 600; margin-bottom: 0.25rem; display: block; color: var(--text-main); }
    .post-meta { font-size: 0.8rem; color: var(--text-muted); }
    
    .editor-area { 
        flex: 1; display: flex; flex-direction: column; padding: 0.5rem; 
        background: white; position: relative; min-height: 300vh;
        margin-left: 300px; transition: margin-left 0.3s ease;
    }
    .sidebar.collapsed + .editor-area, .editor-area.full-width { margin-left: 0; }
    
    .editor-field { margin-bottom: 0.5rem; }
    .editor-field label { display: block; font-size: 0.875rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.5rem; }
    
    .btn { padding: 0.5rem 1rem; border-radius: 4px; font-weight: 500; cursor: pointer; border: none; transition: all 0.2s; display: flex; align-items: center; gap: 0.5rem;}
    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-secondary { background: white; border: 1px solid var(--border); color: var(--text-main); }
    .btn-secondary:hover { background: #f1f5f9; }
    .btn-danger { background: var(--danger); color: white; }
    .btn-danger:hover { background: #dc2626; }
    
    /* New Post Form Styles */
    .form-container { max-width: 600px; margin: 0 auto; width: 100%; }
    .form-group { margin-bottom: 1.5rem; }
    .form-group label { display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main); }
    .input-clean { width: 100%; padding: 0.75rem; border: 1px solid var(--border); border-radius: 6px; font-size: 1rem; outline: none; box-sizing: border-box; }
    .input-clean:focus { border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1); }
    .form-actions { display: flex; gap: 1rem; margin-top: 2rem; }
    
    /* Toast UI Customization */
    .toastui-editor-defaultUI { border: 1px solid var(--border) !important; border-radius: 6px; }
    #toast-editor-container { background: white; }
</style>

<!-- Toast UI Editor JS -->
<script is:inline src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

<script is:inline>
    // --- Configuration ---
    const RAILWAY_API = 'https://twopiggyhavefun-blog-production.up.railway.app';
    const isLocalDev = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
    const API_BASE = isLocalDev ? 'http://localhost:3456' : RAILWAY_API;
    
    let currentSlug = null;
    let allPosts = [];
    let editor = null;
    let isSidebarOpen = true;
    let els = {}; // Initialize empty

    // --- Initialization ---
    document.addEventListener('DOMContentLoaded', () => {
        console.log('DOM Content Loaded - Initializing Editor...');
        
        // 1. Query Elements
        els = {
            loading: document.getElementById('loading'),
            
            // Login View
            loginView: document.getElementById('login-view'),
            appContainer: document.getElementById('app-container'),
            loginPassword: document.getElementById('login-password'),
            loginBtn: document.getElementById('login-btn'),

            // Flickr Modal
            flickrModal: document.getElementById('flickr-modal'),
            closeFlickrModal: document.getElementById('close-flickr-modal'),
            flickrGrid: document.getElementById('flickr-grid'),
            flickrAlbumView: document.getElementById('flickr-album-view'),
            flickrAlbumGrid: document.getElementById('flickr-album-grid'),
            backToAlbums: document.getElementById('back-to-albums'),
            flickrStatus: document.getElementById('flickr-status'),
            tabBtns: document.querySelectorAll('.tab-btn'),
            
            // App Elements
            sidebar: document.getElementById('sidebar'),
            // App Elements
            sidebar: document.getElementById('sidebar'),
            sidebarToggle: document.getElementById('sidebar-toggle'),
            sidebarCloseBtn: document.getElementById('sidebar-close-btn'),
            postList: document.getElementById('post-list'),
            searchInput: document.getElementById('search-input'),
            
            // Editor Actions
            saveBtn: document.getElementById('save-btn'),
            deleteBtn: document.getElementById('delete-btn'),
            newPostBtn: document.getElementById('new-post-btn'),
            logoutBtn: document.getElementById('logout-btn'),
            actionButtons: document.getElementById('action-buttons'),
            
            // Views
            editorView: document.getElementById('editor-view'),
            emptyState: document.getElementById('empty-state'),
            
            // Unified Inputs
            postTitle: document.getElementById('post-title-input'),
            postCategory: document.getElementById('post-category-input'),
            postSlugInput: document.getElementById('post-slug-input'),
        };

        // 2. Attach Event Listeners
        if (els.loginBtn) els.loginBtn.addEventListener('click', handleLogin);
        if (els.loginPassword) els.loginPassword.addEventListener('keydown', (e) => { if(e.key === 'Enter') handleLogin() });
        
        if (els.logoutBtn) els.logoutBtn.addEventListener('click', handleLogout);

        // Flickr Modal Listeners
        if (els.closeFlickrModal) els.closeFlickrModal.addEventListener('click', () => toggleFlickrModal(false));
        if (els.backToAlbums) els.backToAlbums.addEventListener('click', () => showAlbums());
        
        els.tabBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                els.tabBtns.forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                const tab = e.target.getAttribute('data-tab');
                if (tab === 'recent') loadFlickrRecent();
                if (tab === 'albums') loadFlickrAlbums();
            });
        });

        if (els.sidebarToggle) {
            els.sidebarToggle.addEventListener('click', () => {
                isSidebarOpen = !isSidebarOpen;
                toggleSidebar();
            });
        }
        
        if (els.sidebarCloseBtn) {
            els.sidebarCloseBtn.addEventListener('click', () => {
                isSidebarOpen = false;
                toggleSidebar();
            });
        }
        
        function toggleSidebar() {
             if (els.sidebar) els.sidebar.classList.toggle('collapsed', !isSidebarOpen);
             if (els.appContainer) {
                 // Adjust margin using class or inline
                 // Actually relying on CSS adjacency might not work if structure changed.
                 // Let's use a class on wrapper
                 const wrapper = document.querySelector('.main-container');
                 if(wrapper) wrapper.classList.toggle('sidebar-closed', !isSidebarOpen);
             }
        }
        
        if (els.newPostBtn) els.newPostBtn.addEventListener('click', () => showView('new'));
        
        if (els.saveBtn) els.saveBtn.addEventListener('click', savePost);
        if (els.deleteBtn) els.deleteBtn.addEventListener('click', deletePost);

        if (els.searchInput) {
            els.searchInput.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                const filtered = allPosts.filter(p => p.title.toLowerCase().includes(term));
                renderList(filtered);
            });
        }
        
        // Initialize Editor
        const Editor = toastui.Editor;
        editor = new Editor({
            el: document.querySelector('#toast-editor-container'),
            height: '100%',
            initialEditType: 'markdown',
            previewStyle: 'vertical',
            initialValue: '',
            theme: 'dark',
            toolbarItems: [
                ['heading', 'bold', 'italic', 'strike'],
                ['hr', 'quote'],
                ['ul', 'ol', 'task'],
                ['table', 'link'], // Removed 'image'
                ['code', 'codeblock'],
                [{
                    el: createFlickrButton(),
                    tooltip: '插入 Flickr 相片/相簿'
                }]
            ],
            events: {
                change: () => {
                    // Auto-save draft to local storage? (Optional future feature)
                }
            }
        });

        // 0. Helper: Insert content safely in both modes
        function insertToEditor(content) {
            if (editor.isWysiwygMode()) {
                editor.changeMode('markdown');
                editor.insertText(content);
                editor.changeMode('wysiwyg');
            } else {
                editor.insertText(content);
            }
        }

        // 3. Flickr Button Logic
        function createFlickrButton() {
            const button = document.createElement('button');
            button.className = 'image toastui-editor-toolbar-icons';
            button.style.backgroundImage = 'none'; 
            button.style.margin = '0';
            button.innerHTML = '<i class="ph ph-image-square" style="font-size: 18px; color: #555;"></i>';
            
            button.addEventListener('click', () => toggleFlickrModal(true));
            return button;
        }
        
        // 4. Check Auth Status
        checkAuthStatus();
        showLoading(false);
    });
    
    // --- Flickr Logic ---
    function toggleFlickrModal(show) {
        if (els.flickrModal) els.flickrModal.style.display = show ? 'flex' : 'none';
        if (show) {
             // Reset
             loadFlickrRecent();
        }
    }
    
    async function loadFlickrRecent() {
        if(!els.flickrGrid) return;
        els.flickrGrid.innerHTML = '<div style="padding:1rem;">載入中...</div>';
        els.flickrGrid.style.display = 'grid';
        els.flickrAlbumView.style.display = 'none';
        
        try {
            const res = await fetch(`${API_BASE}/api/flickr/recent`);
            const data = await res.json();
            if (data.error) throw new Error(data.error);
            
            const photos = data.photos && data.photos.photo ? data.photos.photo : [];
            renderPhotos(photos, els.flickrGrid);
            els.flickrStatus.textContent = `顯示 ${photos.length} 張相片`;
        } catch (err) {
            els.flickrGrid.innerHTML = `<div style="color:red; margin:1rem;">載入失敗: ${err.message}. 請確認後端目前是否已設定 FLICKR_API_KEY</div>`;
        }
    }
    
    async function loadFlickrAlbums() {
        if(!els.flickrGrid) return;
        els.flickrGrid.innerHTML = '<div style="padding:1rem;">載入中...</div>';
        els.flickrGrid.style.display = 'grid';
        els.flickrAlbumView.style.display = 'none';
        
        try {
            const res = await fetch(`${API_BASE}/api/flickr/albums`);
            const data = await res.json();
             if (data.error) throw new Error(data.error);
             
             const albums = data.photosets && data.photosets.photoset ? data.photosets.photoset : [];
             renderAlbums(albums);
             els.flickrStatus.textContent = `顯示 ${albums.length} 個相簿`;
        } catch (err) {
            els.flickrGrid.innerHTML = `<div style="color:red; margin:1rem;">載入失敗: ${err.message}</div>`;
        }
    }
    
    function renderAlbums(albums) {
        els.flickrGrid.innerHTML = albums.map(alb => {
            const thumb = alb.primary_photo_extras ? alb.primary_photo_extras.url_m : '';
            return `
            <div class="album-item" onclick="loadAlbumPhotos('${alb.id}', '${alb.title._content}')">
                <img src="${thumb}" loading="lazy">
                <div class="album-title">${alb.title._content} (${alb.photos}張)</div>
            </div>
            `;
        }).join('');
    }
    
    async function loadAlbumPhotos(albumId, title) {
        els.flickrGrid.style.display = 'none';
        els.flickrAlbumView.style.display = 'block';
        els.flickrAlbumGrid.innerHTML = '<div style="padding:1rem;">載入照片中...</div>';
        els.backToAlbums.innerText = `< 回到相簿列表 (${title})`;
        
        try {
            const res = await fetch(`${API_BASE}/api/flickr/album/${albumId}/photos`);
            const data = await res.json();
            
            const photos = data.photoset && data.photoset.photo ? data.photoset.photo : [];
            renderPhotos(photos, els.flickrAlbumGrid);
        } catch (err) {
             els.flickrAlbumGrid.innerHTML = `<div style="color:red; margin:1rem;">載入失敗: ${err.message}</div>`;
        }
    }
    
    function showAlbums() {
        els.flickrAlbumView.style.display = 'none';
        els.flickrGrid.style.display = 'grid';
    }
    
    function renderPhotos(photos, container) {
        container.innerHTML = photos.map(p => {
            const url = p.url_m || p.url_o || '';
            // Construct embed code logic locally or use proxy if needed. 
            // For now, let's construct standard HTML.
            // Flickr oEmbed is better but requires an API call per photo (too slow for grid).
            // We will construct the HTML manually using known fields.
            // Owner ID for this account is 158881690@N04.
            const photoPage = `https://www.flickr.com/photos/158881690@N04/${p.id}`;
            const staticSrc = p.url_o || p.url_m; // Prefer Original if available for blog? Or Large?
            // Actually, we usually want specific size. Let's use Large (b) or Original (o).
            
            return `
            <div class="flickr-item" onclick="selectFlickrPhoto('${p.id}', '${p.title}', '${staticSrc}', '${photoPage}')">
                <img src="${p.url_m}" loading="lazy" title="${p.title}">
            </div>
            `;
        }).join('');
    }
    
    function selectFlickrPhoto(id, title, src, pageUrl) {
         // Construct HTML
         // Format: <a href="PAGE"><img src="SRC" alt="TITLE"></a><br><small>Photo via Flickr</small>
         const embedHtml = `<a href="${pageUrl}" title="${title}" target="_blank"><img src="${src}" alt="${title}" style="max-width:100%;"></a><br><small><a href="${pageUrl}">Photo</a> by TwoPiggyHaveFun</small>`;
         
         insertToEditor(embedHtml);
         toggleFlickrModal(false);
    }

    // ... Original insertFlickrPhoto removed/replaced ...


    // --- Core Logic ---

    // 取得 Header (Auth)
    function getHeaders() {
        const headers = { 'Content-Type': 'application/json' };
        const savedPwd = localStorage.getItem('editor_password');
        if (savedPwd) {
            headers['X-Auth-Password'] = savedPwd;
        }
        return headers;
    }

    // Auth & View Switching
    // Auth & View Switching
    function checkAuthStatus() {
        const savedPwd = localStorage.getItem('editor_password');
        if (savedPwd) {
            // Found saved password, try auto-login.
            // Show loading to prevent user from typing in login form while we verify.
            showLoading(true);
            loadPosts(true); 
        } else {
            showLogin();
        }
    }
    
    function showLogin() {
        if (els.loginView) els.loginView.style.display = 'flex';
        if (els.appContainer) els.appContainer.style.display = 'none';
        // Focus password input
        if (els.loginPassword) els.loginPassword.focus();
    }
    
    function showApp() {
        if (els.loginView) els.loginView.style.display = 'none';
        if (els.appContainer) els.appContainer.style.display = 'block';
    }

    async function handleLogin() {
        const pwd = els.loginPassword.value;
        if (!pwd) { alert('請輸入密碼'); return; }
        
        localStorage.setItem('editor_password', pwd);
        await loadPosts(false);
    }
    
    function handleLogout() {
        if (confirm('確定要登出嗎？')) {
            localStorage.removeItem('editor_password');
            if (els.loginPassword) els.loginPassword.value = '';
            showLogin();
        }
    }

    async function loadPosts(isAutoLogin = false) {
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts`, {
                headers: getHeaders()
            });
            if (res.status === 401) {
                if (localStorage.getItem('editor_password')) {
                    // Only alert if it was a manual login attempt. 
                    // If auto-login, just silently fail back to login screen.
                     if (!isAutoLogin) alert('密碼錯誤，請重新登入');
                    localStorage.removeItem('editor_password');
                }
                showLogin();
                showLoading(false);
                return;
            }
            if (!res.ok) throw new Error('API Error');

            allPosts = await res.json();
            renderList(allPosts);
            showApp(); // Success -> Show App
            
        } catch (err) {
            console.error(err);
            if (!isAutoLogin) alert('無法載入文章列表 (或網路連線錯誤)');
            showLogin(); // Fallback
        }
        showLoading(false);
    }

    function renderList(posts) {
        if (!els.postList) return;
        els.postList.innerHTML = posts.map(post => `
            <div class="post-item ${currentSlug === post.slug ? 'active' : ''}" onclick="selectPost('${post.slug}')">
                <span class="post-title">${post.title}</span>
                <span class="post-meta">${post.date || ''} · ${post.category || '未分類'}</span>
            </div>
        `).join('');
    }

    async function selectPost(slug) {
        currentSlug = slug;
        showLoading(true);
        
        // Update UI selection
        const items = document.querySelectorAll('.post-item');
        items.forEach(i => i.classList.remove('active'));
        // Re-render list to highlight active (simple way)
        renderList(allPosts);

        try {
            const res = await fetch(`${API_BASE}/api/posts/${slug}`, {
                headers: getHeaders()
            });
            
            if (res.status === 401) {
                alert('登入逾時，請重新登入');
                localStorage.removeItem('editor_password');
                showLogin();
                showLoading(false);
                return;
            }
            
            if (!res.ok) throw new Error(`API Error: ${res.status}`);

            const data = await res.json();
            
            // Populate Inputs & Editor
            if (els.postTitle) {
                els.postTitle.value = allPosts.find(p => p.slug === slug)?.title || slug;
                els.postTitle.disabled = true; // Disable metadata editing for existing posts
            }
            if (els.postSlugInput) {
                els.postSlugInput.value = data.slug;
                els.postSlugInput.disabled = true;
            }
            if (els.postCategory) {
                 const cat = allPosts.find(p => p.slug === slug)?.category;
                 if (cat) els.postCategory.value = cat;
                 els.postCategory.disabled = true;
            }

            if (editor) {
                editor.setMarkdown(String(data.content));
                editor.setScrollTop(0);
            }
            
            showView('editor');
            
            // Mobile check
            if (window.innerWidth < 768 && els.sidebar) {
                els.sidebar.classList.add('collapsed');
            }
            
        } catch (err) {
            console.error(err);
            alert(`載入失敗: ${err.message}`);
        }
        showLoading(false);
    }
    
    function showView(viewName) {
        if (els.editorView) els.editorView.style.display = 'none';
        if (els.emptyState) els.emptyState.style.display = 'none';
        
        if (viewName === 'editor') {
            if (els.editorView) {
                els.editorView.style.display = 'flex';
                els.editorView.style.flexDirection = 'column';
                els.editorView.style.flex = '1';
                
                // If currentSlug is null, it means NEW POST Mode
                // Enable inputs
                if (!currentSlug) {
                    if (els.postTitle) { els.postTitle.value = ''; els.postTitle.disabled = false; }
                    if (els.postSlugInput) { els.postSlugInput.value = ''; els.postSlugInput.disabled = false; }
                    if (els.postCategory) { els.postCategory.disabled = false; } // Keep default selection
                    if (editor) editor.setMarkdown('');
                    
                    if (els.deleteBtn) els.deleteBtn.style.display = 'none';
                } else {
                    if (els.deleteBtn) els.deleteBtn.style.display = 'flex';
                }
            }
            if (els.actionButtons) els.actionButtons.style.display = 'flex';
        } else if (viewName === 'new') {
            currentSlug = null;
            showView('editor'); // Reuse editor view for new post
        } else {
            if (els.emptyState) els.emptyState.style.display = 'flex';
            if (els.actionButtons) els.actionButtons.style.display = 'none'; // Hide buttons on empty state
            currentSlug = null;
        }
    }

    // --- Actions ---
    async function savePost() {
        const content = editor.getMarkdown();
        showLoading(true);

        try {
            // Case 1: NEW POST (Create)
            if (!currentSlug) {
                const title = els.postTitle.value.trim();
                const category = els.postCategory.value;
                const customSlug = els.postSlugInput.value.trim();
                
                if (!title) { alert('請輸入文章標題'); showLoading(false); return; }

                // Generate temp link
                const tempLink = `https://twopiggyhavefun.uk/posts/${customSlug || 'draft-' + Date.now()}`;
                
                const payload = {
                    title,
                    category,
                    slug: customSlug,
                    content: content || '\n', // Ensure content exists
                    link: tempLink
                };

                const res = await fetch(`${API_BASE}/api/posts`, {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                
                if (result.success) {
                    alert(result.deploying ? '文章建立成功！正在自動部署...' : '文章建立成功');
                    await loadPosts();
                    selectPost(result.slug); // Output from backend
                } else {
                    alert('建立失敗: ' + result.error);
                }

            } 
            // Case 2: EXISTING POST (Update)
            else {
                const res = await fetch(`${API_BASE}/api/posts/${currentSlug}`, {
                    method: 'PUT',
                    headers: getHeaders(),
                    body: JSON.stringify({ content })
                });
                const result = await res.json();
                
                if (result.success) {
                    alert(result.deploying ? '儲存成功！正在自動部署...' : '儲存成功');
                    loadPosts(); // Refresh list to update dates/titles if changed (backend doesn't update metadata yet though)
                } else {
                    alert('失敗: ' + result.error);
                }
            }
        } catch (err) {
            console.error(err);
            alert('連線失敗');
        }
        showLoading(false);
    }
    
    async function deletePost() {
        if (!currentSlug || !confirm('確定要刪除這篇文章嗎？此動作無法復原。')) return;
        showLoading(true);
        try {
            const res = await fetch(`${API_BASE}/api/posts/${currentSlug}`, { 
                method: 'DELETE', headers: getHeaders() 
            });
            const result = await res.json();
            if (result.success) {
                alert('刪除成功');
                showView('empty');
                loadPosts();
            } else {
                alert('刪除失敗');
            }
        } catch (err) {
            alert('連線失敗');
        }
        showLoading(false);
    }
    
    // UI Helpers
    function showLoading(show) {
        const loader = document.getElementById('loading');
        if (loader) loader.style.display = show ? 'flex' : 'none';
    }
</script>
