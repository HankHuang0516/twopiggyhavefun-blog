---
import Layout from '../layouts/Layout.astro';
import SearchWidget from '../components/SearchWidget.astro';

---

<Layout title="404 - 找不到頁面">
    <div class="container mx-auto px-4 py-20 text-center min-h-[60vh] flex flex-col items-center justify-center">
        <div class="text-9xl mb-4">🐷</div>
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 font-mono">404</h1>
        <p class="text-xl text-gray-600 mb-8 max-w-md mx-auto">
            哎呀！這裡什麼都沒有。<br/>
            可能是連結失效，或是文章搬家了。
        </p>

        <div class="w-full max-w-md mb-10">
            <SearchWidget />
        </div>

        <div class="flex flex-wrap justify-center gap-4">
            <a href="/twopiggyhavefun-blog/" class="bg-[#c9a961] text-white px-6 py-3 rounded-full hover:bg-[#b09350] transition shadow-md font-bold">
                回首頁
            </a>
            <a href="/twopiggyhavefun-blog/category/travel" class="bg-white border border-gray-300 text-gray-700 px-6 py-3 rounded-full hover:bg-gray-50 transition shadow-sm">
                看旅遊景點
            </a>
        </div>
    </div>
</Layout>
