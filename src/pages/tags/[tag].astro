---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths({ paginate }) {
  const allPosts = (await getCollection('posts')).filter(p => p.data);
  
  const allTags: string[] = [];
  for (const post of allPosts) {
    const tags = post.data.tags;
    if (Array.isArray(tags)) {
      for (const tag of tags) {
        if (typeof tag === 'string' && tag.trim()) {
          allTags.push(tag.trim());
        }
      }
    }
  }
  const uniqueTags = [...new Set(allTags)].filter(tag => !/[*?"<>|\\/:]/.test(tag));

  return uniqueTags.flatMap((tag) => {
    const filteredPosts = allPosts.filter((post) => {
      const tags = post.data.tags;
      return Array.isArray(tags) && tags.includes(tag);
    });
    
     // Sort by date text descending
    filteredPosts.sort((a, b) => {
        if (!a.data?.date || !b.data?.date) return 0;
        return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
    });

    return paginate(filteredPosts, {
      params: { tag },
      pageSize: 12
    });
  });
}

const { tag } = Astro.params;
const { page } = Astro.props;
const posts = page.data;

const displayTitle = `#${tag}`;
---

<Layout title={displayTitle}>
  <div class="container mx-auto px-4 py-12">
    <header class="mb-12 text-center bg-gray-50 py-10 rounded-2xl border border-gray-100">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3 flex items-center justify-center gap-3">
             <span class="text-[#c9a961]">🏷️</span> {displayTitle}
        </h1>
        <p class="text-gray-500 font-medium">共 {posts.length} 篇文章</p>
    </header>

    {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map((post) => (
                <PostCard 
                    title={post.data.title} 
                    slug={post.slug} 
                    date={post.data.date} 
                    cover={post.data.cover}
                    tags={post.data.tags}
                    category={post.data.category}
                />
            ))}
        </div>
    ) : (
        <div class="text-center py-20 bg-gray-50 rounded-2xl border border-gray-100">
            <h2 class="text-2xl font-bold text-gray-700 mb-2">這裡還沒有文章</h2>
            <div class="flex justify-center gap-4 mt-6">
                <a href="/twopiggyhavefun-blog/" class="text-blue-600 hover:text-white hover:bg-blue-600 px-6 py-2 rounded-full border border-blue-200 transition">
                    回首頁
                </a>
            </div>
        </div>
    )}
  </div>

  <Pagination page={page} />
  </div>
</Layout>
