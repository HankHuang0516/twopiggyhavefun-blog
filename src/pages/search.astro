---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const { q } = Astro.url.searchParams;
const query = q || '';

// Get all posts
const allPosts = await getCollection('posts');
const posts = allPosts.filter(p => p.data);

// Client-side search logic will happen in the script below
// But we prepare the data structure for Fuse.js
const serializedPosts = posts.map(post => ({
    title: post.data.title,
    description: post.data.description,
    slug: post.slug,
    date: post.data.date,
    category: post.data.category,
    cover: post.data.cover
}));
---

<Layout title={`搜尋結果: ${query}`}>
    <div class="container mx-auto px-4 py-12">
        <header class="mb-12 text-center bg-gray-50 py-10 rounded-2xl border border-gray-100">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
                搜尋結果
            </h1>
            <p class="text-gray-500 text-lg">
                關鍵字：<span class="text-blue-600 font-bold">"{query}"</span>
            </p>
        </header>

        <div id="search-results" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Results injected here -->
            <div class="col-span-full text-center py-20">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900 mb-4"></div>
                <p class="text-gray-500">正在搜尋...</p>
            </div>
        </div>
        
        <div id="no-results" class="hidden text-center py-20 bg-gray-50 rounded-lg">
            <p class="text-gray-500 text-lg mb-4">找不到與 "<span class="font-bold">{query}</span>" 相關文章。</p>
            <a href="/twopiggyhavefun-blog/" class="text-blue-600 hover:underline">返回首頁</a>
        </div>
    </div>
</Layout>

<script define:vars={{ serializedPosts }}>
    import Fuse from 'https://cdn.jsdelivr.net/npm/fuse.js@6.6.2/dist/fuse.esm.js';

    document.addEventListener('DOMContentLoaded', () => {
        const resultsContainer = document.getElementById('search-results');
        const noResults = document.getElementById('no-results');
        
        // Fix: Read query directly from URL on client side (GitHub Pages is static)
        const params = new URLSearchParams(window.location.search);
        const urlQuery = params.get('q') || '';
        
        // Update Title and Input if they exist
        const titleSpan = document.querySelector('header h1 + p span');
        if (titleSpan) titleSpan.textContent = `"${urlQuery}"`;
        
        const searchInput = document.getElementById('search-input');
        if (searchInput && urlQuery) searchInput.value = urlQuery;

        // CRITICAL FIX: Only return early if *both* are empty. 
        // Logic: if urlQuery is present, we MUST proceed to search.
        if (!urlQuery) {
            resultsContainer.innerHTML = '';
            noResults.classList.remove('hidden');
            // Hide the spinner if query is empty
            const spinner = resultsContainer.querySelector('.animate-spin');
            if(spinner) spinner.parentElement.remove();
            return;
        }

        const fuse = new Fuse(serializedPosts, {
            keys: ['title', 'description', 'category'],
            threshold: 0.4,
            includeScore: true
        });

        const results = fuse.search(urlQuery);

        if (results.length === 0) {
            resultsContainer.innerHTML = '';
            noResults.classList.remove('hidden');
        } else {
            noResults.classList.add('hidden');
            resultsContainer.innerHTML = results.map(result => {
                const post = result.item;
                const date = new Date(post.date).toLocaleDateString('zh-TW');
                const cover = post.cover || '/twopiggyhavefun-blog/placeholder.jpg';
                // Fix path
                const safeCover = cover.startsWith('/') && !cover.startsWith('/twopiggyhavefun-blog') 
                    ? `/twopiggyhavefun-blog${cover}` 
                    : cover;

                return `
                    <article class="bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col h-full border border-gray-100 group">
                        <a href="/twopiggyhavefun-blog/posts/${post.slug}" class="block overflow-hidden h-48 relative">
                            <img src="${safeCover}" alt="${post.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        </a>
                        <div class="p-6 flex-1 flex flex-col">
                            <div class="mb-2 text-sm text-gray-500 flex justify-between">
                                <span>${date}</span>
                                <span class="text-blue-500">${post.category || '未分類'}</span>
                            </div>
                            <h2 class="text-xl font-bold mb-3 leading-snug text-gray-800 group-hover:text-blue-600 transition-colors line-clamp-2">
                                <a href="/twopiggyhavefun-blog/posts/${post.slug}">${post.title}</a>
                            </h2>
                            <p class="text-gray-600 text-sm line-clamp-2 mb-4 flex-1">${post.description || ''}</p>
                            <a href="/twopiggyhavefun-blog/posts/${post.slug}" class="mt-auto text-blue-600 font-medium hover:underline">
                                繼續閱讀 →
                            </a>
                        </div>
                    </article>
                `;
            }).join('');
        }
    });
</script>
