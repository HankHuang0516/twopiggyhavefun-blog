---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PostCard from '../../components/PostCard.astro';
import BusinessStatus from '../../components/BusinessStatus.astro';
import { getCategorySlug, SIDEBAR_CATEGORIES } from '../../utils/categories';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(p => p.data);
  // Sort by date descending
  posts.sort((a, b) => {
    if (!a.data?.date || !b.data?.date) return 0;
    return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
  });

  return posts.map((post, index) => {
    // Get related posts (same category, exclude current, random shuffle, max 3)
    const relatedPosts = posts.filter(p => 
        p.slug !== post.slug && 
        p.data.category === post.data.category
    )
    .sort(() => 0.5 - Math.random())
    .slice(0, 3);

    return {
        params: { slug: post.slug },
        props: { 
            post,
            prevPost: index < posts.length - 1 ? posts[index + 1] : null,
            nextPost: index > 0 ? posts[index - 1] : null,
            relatedPosts
        },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;
const { Content, headings } = await post.render();

// Calculate Reading Time (Chinese = ~300-500 chars/min, Code blocks handled roughly)
const textContent = post.body || "";
const wordCount = textContent.length;
const readingTime = Math.ceil(wordCount / 400); // 400 chars per minute average

const safeDate = post.data.date ? new Date(post.data.date) : new Date();
const formattedDate = safeDate.toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
});

// Share URLs
const currentUrl = `https://hankhuang0516.github.io/twopiggyhavefun-blog/posts/${post.slug}`;
const fbShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;
const lineShareUrl = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(currentUrl)}`;

// JSON-LD Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "image": post.data.cover ? [post.data.cover] : [],
  "datePublished": safeDate.toISOString(),
  "dateModified": safeDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": "兩隻小豬"
  },
  "description": post.data.description || post.data.title
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首頁",
      "item": "https://hankhuang0516.github.io/twopiggyhavefun-blog/"
    },
    ...(post.data.category ? [{
      "@type": "ListItem",
      "position": 2,
      "name": post.data.category,
      "item": `https://hankhuang0516.github.io/twopiggyhavefun-blog/category/${getCategorySlug(post.data.category)}`
    }] : [])
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<Layout title={post.data.title} description={post.data.description} image={post.data.cover}>
    <div class="container mx-auto px-4 py-8">
        <!-- Breadcrumbs -->
        <nav class="flex text-sm text-gray-500 mb-6 overflow-x-auto whitespace-nowrap pb-2 gap-2 items-center">
            <a href="/twopiggyhavefun-blog/" class="bg-gray-100 hover:bg-gray-200 px-3 py-1 rounded-full transition text-gray-700 flex-shrink-0">首頁</a>
            <span class="text-gray-300 flex-shrink-0">›</span>
            {post.data.category && (
                <>
                    <a href={`/twopiggyhavefun-blog/category/${getCategorySlug(post.data.category)}`} class="bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-1 rounded-full transition font-medium flex-shrink-0">
                        {post.data.category}
                    </a>
                    <span class="text-gray-300 flex-shrink-0">›</span>
                </>
            )}
            <span class="text-gray-500 px-2 py-1 truncate max-w-[150px]">{post.data.title}</span>
        </nav>

        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Main Article -->
            <article class="flex-1 relative">
                <!-- Floating Share Buttons (Desktop) -->
                <div class="hidden lg:flex flex-col gap-3 fixed left-4 top-1/2 -translate-y-1/2 z-40">
                    <a href={fbShareUrl} target="_blank" rel="noopener noreferrer"
                       class="w-10 h-10 bg-blue-600 text-white flex items-center justify-center rounded hover:bg-blue-700 transition"
                       title="分享到 Facebook">
                        <span class="text-lg">f</span>
                    </a>
                    <a href={lineShareUrl} target="_blank" rel="noopener noreferrer"
                       class="w-10 h-10 bg-green-500 text-white flex items-center justify-center rounded hover:bg-green-600 transition"
                       title="分享到 LINE">
                        <span class="text-lg">L</span>
                    </a>
                </div>

                <!-- Article Header -->
                <header class="mb-8">
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 leading-tight">
                        {post.data.title}
                    </h1>
                    <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-4">
                        <span>{formattedDate}</span>
                        <span class="text-gray-300">|</span>
                        <span class="flex items-center gap-1" title={`約 ${wordCount} 字`}>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            {readingTime} 分鐘閱讀
                        </span>
						{post.data.tags && post.data.tags.length > 0 && (
							<>
								<span class="text-gray-300">|</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
								{post.data.tags.map(tag => (
									<a href={`/twopiggyhavefun-blog/category/${tag}`} class="bg-gray-100 text-gray-700 px-3 py-1.5 rounded-full text-sm hover:bg-gray-200 transition">
										{tag}
									</a>
								))}
							</>
						)}

                    </div>

                    <!-- Business Status -->
                    <BusinessStatus 
                        businessName={post.data.title}
                        rawHours={post.data.businessHours}
                        permanentlyClosed={post.data.isPermanentlyClosed}
                    />

                    {post.data.originalUrl && (
                        <a href={post.data.originalUrl} target="_blank" rel="noopener noreferrer" 
                           class="text-blue-600 text-sm hover:underline">
                            原文連結 (Pixnet) ↗
                        </a>
                    )}
                </header>

                <!-- Table of Contents (Mobile Friendly Collapsible) -->
                {headings && headings.length > 0 && (
                    <div class="mb-8 border border-gray-200 rounded-lg overflow-hidden">
                        <details class="group bg-gray-50">
                            <summary class="flex items-center justify-between p-4 font-bold text-gray-700 cursor-pointer select-none">
                                <span>📖 文章目錄 (Table of Contents)</span>
                                <span class="transition group-open:rotate-180">▼</span>
                            </summary>
                            <nav class="p-4 pt-0 bg-white">
                                <ul class="space-y-2 text-sm mt-3">
                                    {headings.filter(h => h.depth <= 3).map(h => (
                                        <li class={`pl-${(h.depth - 1) * 3} border-l-2 border-transparent hover:border-blue-500`}>
                                            <a href={`#${h.slug}`} class="block py-1 text-gray-600 hover:text-blue-600 transition truncate">
                                                {h.text}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </nav>
                        </details>
                    </div>
                )}

                <!-- Featured Image -->
                {post.data.cover && (
                    <div class="mb-8">
                        <img 
                            src={post.data.cover.startsWith('/') && !post.data.cover.startsWith('/twopiggyhavefun-blog') 
                                ? `/twopiggyhavefun-blog${post.data.cover}` 
                                : post.data.cover} 
                            alt={post.data.title}
                            class="w-full h-auto max-h-[500px] object-cover"
                        />
                    </div>
                )}

                <!-- Article Content -->
                <div class="prose prose-lg max-w-none pixnet-content bg-white p-6 md:p-8 border border-gray-200">
                    <Content />
                </div>

                <!-- Personal Category Link -->
                {post.data.category && (
                    <div class="mt-6 p-4 bg-gray-50 border border-gray-200 rounded-lg mb-8">
                        <span class="text-gray-600 text-sm">個人分類：</span>
                        <a 
                            href={`/twopiggyhavefun-blog/category/${getCategorySlug(post.data.category)}`}
                            class="text-blue-600 hover:underline font-medium"
                        >
                            {post.data.category}
                        </a>
                    </div>
                )}

                <!-- Related Posts (You Might Also Like) -->
                <div class="mb-20 lg:mb-12 border-t border-gray-200 pt-8">
                    <h3 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
                        <span>💡</span> 延伸閱讀
                    </h3>
                    
                    <!-- Next/Prev Custom Navigation -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                        {nextPost && (
                            <a href={`/twopiggyhavefun-blog/posts/${nextPost.slug}`} class="flex flex-col p-4 border border-blue-100 rounded-lg bg-blue-50 hover:bg-blue-100 transition group text-left h-full">
                                <span class="text-xs text-blue-500 font-bold tracking-wider mb-2 flex items-center gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                    </svg>
                                    上一篇 (Newer)
                                </span>
                                <span class="text-gray-800 font-medium line-clamp-2 group-hover:text-blue-700 mt-auto">{nextPost.data.title}</span>
                            </a>
                        )}
                        {!nextPost && <div class="hidden md:block"></div>}

                        {prevPost && (
                            <a href={`/twopiggyhavefun-blog/posts/${prevPost.slug}`} class="flex flex-col p-4 border border-blue-100 rounded-lg bg-blue-50 hover:bg-blue-100 transition group text-right h-full">
                                <span class="text-xs text-blue-500 font-bold tracking-wider mb-2 flex items-center justify-end gap-1">
                                    下一篇 (Older)
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                    </svg>
                                </span>
                                <span class="text-gray-800 font-medium line-clamp-2 group-hover:text-blue-700 mt-auto">{prevPost.data.title}</span>
                            </a>
                        )}
                    </div>

                     <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {relatedPosts.length > 0 ? (
                            <div class="col-span-1 md:col-span-2">
                                <h4 class="text-lg font-bold text-gray-700 mb-4">猜你喜歡...</h4>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                    {relatedPosts.map(p => (
                                        <PostCard 
                                            title={p.data.title} 
                                            slug={p.slug} 
                                            date={p.data.date} 
                                            cover={p.data.cover}
                                            tags={[]} 
                                            category={p.data.category} 
                                        />
                                    ))}
                                </div>
                            </div>
                        ) : (
                             <div class="col-span-1 md:col-span-2 text-center py-4 bg-gray-50 rounded-lg">
                                <p class="text-gray-500 mb-2">想看更多類似文章嗎？</p>
                                <a href={`/twopiggyhavefun-blog/category/${post.data.category ? getCategorySlug(post.data.category) : 'domestic-travel'}`} 
               class="bg-gray-100 hover:bg-gray-200 px-3 py-1 rounded-full transition text-gray-700 flex-shrink-0 font-medium">
                {post.data.category || '國內旅遊'}
            </a>
                             </div>
                        )}
                    </div>
                </div>

                <!-- Mobile Sticky Share Bar -->
                <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-3 pb-[env(safe-area-inset-bottom,20px)] flex justify-center gap-3 lg:hidden z-50 shadow-[0_-2px_10px_rgba(0,0,0,0.1)]">
                    <span class="text-sm font-bold text-gray-500 self-center mr-2">分享：</span>
                    <a href={fbShareUrl} target="_blank" rel="noopener noreferrer"
                       class="bg-[#1877F2] text-white px-4 py-2 rounded-full flex items-center gap-1.5 hover:bg-blue-700 transition shadow-sm text-sm font-medium">
                        <span class="text-base">f</span> Facebook
                    </a>
                    <a href={lineShareUrl} target="_blank" rel="noopener noreferrer"
                       class="bg-[#00C300] text-white px-4 py-2 rounded-full flex items-center gap-1.5 hover:bg-green-600 transition shadow-sm text-sm font-medium">
                        <span class="text-base">L</span> LINE
                    </a>
                    <button id="mobile-copy-link" class="bg-gray-100 text-gray-600 px-4 py-2 rounded-full flex items-center gap-1.5 hover:bg-gray-200 transition shadow-sm text-sm font-medium active:bg-gray-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        複製
                    </button>
                </div>
                

            </article>

            <!-- Sidebar -->
            <Sidebar />
        </div>
    </div>
</Layout>

<style is:global>
    /* Pixnet Content Overrides */
    /* Pixnet Content Overrides */
    /* Pixnet Content Overrides handled in Layout.astro to ensure consistency */
    .pixnet-content img {
        margin: 1.5em auto;
        max-width: 100%;
        height: auto;
    }
    .pixnet-content iframe {
        max-width: 100%;
        margin: 1.5em auto;
        aspect-ratio: 16/9;
        height: auto;
    }
    .pixnet-content p {
        margin-bottom: 1.5em;
        line-height: 1.9;
        font-size: 1.125rem; /* 18px base for better reading */
        color: #2d3748; /* Softer black */
    }
    .pixnet-content a {
        color: #337ab7;
    }
    .pixnet-content a:hover {
        text-decoration: underline;
    }
    .breadcrumb-title {
        display: inline-block;
        max-width: 150px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: bottom;
    }
    @media (min-width: 768px) {
        .breadcrumb-title {
            max-width: 300px;
        }
    }
</style>

<script>
    // Fix content images client-side to handle base URL
    document.addEventListener('DOMContentLoaded', () => {
        const baseUrl = '/twopiggyhavefun-blog';
        const contentImages = document.querySelectorAll('.pixnet-content img');
        
        contentImages.forEach(img => {
            const src = img.getAttribute('src');
            if (src && src.startsWith('/') && !src.startsWith(baseUrl)) {
                img.src = `${baseUrl}${src}`;
            }
        });

        // Mobile Copy Link Logic
        const copyBtn = document.getElementById('mobile-copy-link');
        if (copyBtn) {
            copyBtn.addEventListener('click', async (e) => {
                try {
                    const btn = e.currentTarget;
                    await navigator.clipboard.writeText(window.location.href);
                    const originalText = btn.innerHTML;
                    btn.innerHTML = '<span class="text-green-600 font-bold">已複製!</span>';
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy', err);
                }
            });
        }
    });
</script>
