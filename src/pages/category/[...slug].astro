---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { 
    categorizePost, 
    isForeignTravel, 
    isParenting, 
    isUnboxing, 
    isWedding, 
    regionNames,
    regionKeywords,
    PIXNET_CATEGORY_HIERARCHY,
    getCategorySlug
} from '../../utils/categories';

const { slug } = Astro.params;
const { categoryTitle, posts, pageNum, totalPages } = Astro.props;
const BASE_URL = '/twopiggyhavefun-blog';

// Generate paths manually to avoid "paginate" helper quirks with [...slug]
export async function getStaticPaths() {
    const allPosts = (await getCollection('posts')).filter(p => p.data);
    // Sort desc
    allPosts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

    const categories = new Map();

    function addToBucket(key, title, post) {
        if (!categories.has(key)) categories.set(key, { title, posts: [] });
        categories.get(key).posts.push(post);
    }

    // 1. Main Categories
    for (const [name, config] of Object.entries(PIXNET_CATEGORY_HIERARCHY)) {
        const posts = allPosts.filter(p => getCategorySlug(p.data.category) === config.slug);
        categories.set(config.slug, { title: name, posts });
    }

    // 2. Sub/Tags
    allPosts.forEach(p => {
        if (p.data.category) addToBucket(p.data.category, p.data.category, p);
        (p.data.tags || []).forEach(t => addToBucket(t, t, p));
    });

    const paths = [];
    const PAGE_SIZE = 12;

    for (const [catSlug, data] of categories.entries()) {
        const totalPosts = data.posts.length;
        if (totalPosts === 0) continue; // Skip empty
        const totalPages = Math.ceil(totalPosts / PAGE_SIZE);

        for (let i = 1; i <= totalPages; i++) {
            const pagePosts = data.posts.slice((i - 1) * PAGE_SIZE, i * PAGE_SIZE);
            
            // Page 1 is just the slug (e.g., "domestic-travel")
            // Page 2+ is "domestic-travel/2"
            const urlSlug = i === 1 ? catSlug : `${catSlug}/${i}`;

            paths.push({
                params: { slug: urlSlug },
                props: {
                    categoryTitle: data.title,
                    posts: pagePosts,
                    pageNum: i,
                    totalPages
                }
            });
        }
    }
    return paths;
}

function fixImagePath(src) {
    if (!src) return `${BASE_URL}/placeholder.jpg`;
    if (src.startsWith('http')) return src;
    if (src.startsWith('/') && !src.startsWith(BASE_URL)) return `${BASE_URL}${src}`;
    return src;
}

// Construct Prev/Next URLs logic
// We need to know the 'base' category slug to build links.
// We can derive it by removing `/${pageNum}` from current slug if pageNum > 1
const currentSlug = slug;
const baseCategorySlug = pageNum === 1 ? currentSlug : currentSlug.replace(`/${pageNum}`, '');

const prevUrl = pageNum === 1 ? null : 
    (pageNum === 2 ? `${BASE_URL}/category/${baseCategorySlug}` : `${BASE_URL}/category/${baseCategorySlug}/${pageNum - 1}`);

const nextUrl = pageNum === totalPages ? null : `${BASE_URL}/category/${baseCategorySlug}/${pageNum + 1}`;

---

<Layout title={`${categoryTitle} - 兩隻小豬`}>
    <main class="container mx-auto max-w-7xl p-4 flex flex-col lg:flex-row gap-8">
        <!-- Content Area -->
        <div class="flex-1">
            <header class="mb-8 border-b border-gray-200 pb-4">
                <h1 class="text-3xl font-bold text-gray-800 flex items-center gap-2">
                    <span class="text-blue-600">📂</span> {categoryTitle}
                </h1>
                <p class="text-gray-500 mt-2">
                    第 {pageNum} / {totalPages} 頁
                </p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {posts.map((post) => (
                    <article class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition overflow-hidden">
                        <a href={`${BASE_URL}/posts/${post.slug}`} class="block h-full">
                            <div class="aspect-w-16 aspect-h-9 bg-gray-100 relative h-48">
                                <img 
                                    src={fixImagePath(post.data.cover)} 
                                    alt={post.data.title}
                                    class="w-full h-full object-cover transition duration-300 hover:scale-105"
                                    loading="lazy"
                                />
                            </div>
                            <div class="p-4">
                                <h2 class="text-lg font-bold text-gray-800 mb-2 line-clamp-2 hover:text-blue-600">
                                    {post.data.title}
                                </h2>
                                <div class="flex flex-wrap gap-2 text-xs text-gray-500 mb-3">
                                    <span>📅 {new Date(post.data.date).toLocaleDateString('zh-TW')}</span>
                                    {post.data.tags && post.data.tags.slice(0, 3).map((tag: string) => (
                                        <span class="bg-gray-100 px-2 py-0.5 rounded">{tag}</span>
                                    ))}
                                </div>
                            </div>
                        </a>
                    </article>
                ))}
            </div>

            {posts.length === 0 && (
                <div class="text-center py-20 text-gray-500">
                    <p class="text-xl">此分類目前沒有文章。</p>
                    <a href={BASE_URL} class="text-blue-500 hover:underline mt-4 inline-block">返回首頁</a>
                </div>
            )}

            <!-- Pagination Controls -->
            {totalPages > 1 && (
                <div class="mt-12 flex justify-center gap-2">
                    {prevUrl ? (
                        <a href={prevUrl} class="px-4 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50">
                            &larr; 上一頁
                        </a>
                    ) : (
                        <span class="px-4 py-2 border border-gray-200 text-gray-300 rounded cursor-not-allowed">
                            &larr; 上一頁
                        </span>
                    )}
                    
                    <span class="px-4 py-2 text-gray-500">
                        {pageNum} / {totalPages}
                    </span>

                    {nextUrl ? (
                        <a href={nextUrl} class="px-4 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50">
                            下一頁 &rarr;
                        </a>
                    ) : (
                        <span class="px-4 py-2 border border-gray-200 text-gray-300 rounded cursor-not-allowed">
                            下一頁 &rarr;
                        </span>
                    )}
                </div>
            )}
        </div>

        <!-- Sidebar -->
        <Sidebar />
    </main>
</Layout>
