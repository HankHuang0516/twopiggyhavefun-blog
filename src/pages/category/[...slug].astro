---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { 
    categorizePost, 
    isForeignTravel, 
    isParenting, 
    isUnboxing, 
    isWedding, 
    regionNames,
    regionKeywords,
    PIXNET_CATEGORY_HIERARCHY,
    getCategorySlug
} from '../../utils/categories';

export async function getStaticPaths({ paginate }) {
    const allPosts = (await getCollection('posts')).filter(p => p.data);
    
    // Sort posts by date desc first
    allPosts.sort((a, b) => {
        if (!a.data?.date || !b.data?.date) return 0;
        return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
    });

    const categories = new Map(); // slug -> { title, posts[] }

    // Helper to add post to a category bucket
    function addToBucket(slug, title, post) {
        if (!categories.has(slug)) {
            categories.set(slug, { title, posts: [] });
        }
        categories.get(slug).posts.push(post);
    }

    // 1. Process Main Categories from Hierarchy
    for (const [name, config] of Object.entries(PIXNET_CATEGORY_HIERARCHY)) {
        // Collect all posts belonging to this main category
        const posts = allPosts.filter(post => getCategorySlug(post.data.category) === config.slug);
        categories.set(config.slug, { title: name, posts });
    }

    // 2. Process Subcategories & Tags
    // Iterate all posts to find unique tags/categories
    allPosts.forEach(post => {
        const cat = post.data.category;
        const tags = post.data.tags || [];

        // Add by direct category slug (if strict match)
        if (cat) {
             // If it's not a main category slug, treat as sub
            const slug = cat; 
            // Only add if we haven't handled this slug via main category logic above?
            // Actually, we want to support /category/台北美食 explicitly
            addToBucket(slug, slug, post);
        }

        // Add by tags
        tags.forEach(tag => {
            addToBucket(tag, tag, post);
        });
    });

    // 3. Generate Pagination Paths
    const paths = [];
    for (const [slug, data] of categories.entries()) {
        const paged = paginate(data.posts, {
            params: { slug },
            props: { categoryTitle: data.title },
            pageSize: 12
        });
        paths.push(...paged);
    }

    return paths;
}

const { page, categoryTitle } = Astro.props;
const BASE_URL = '/twopiggyhavefun-blog';

function fixImagePath(src: string | undefined): string {
    if (!src) return `${BASE_URL}/placeholder.jpg`;
    if (src.startsWith('http')) return src;
    if (src.startsWith('/') && !src.startsWith(BASE_URL)) {
        return `${BASE_URL}${src}`;
    }
    return src;
}
---

<Layout title={`${categoryTitle} - 兩隻小豬`}>
    <main class="container mx-auto max-w-7xl p-4 flex flex-col lg:flex-row gap-8">
        <!-- Content Area -->
        <div class="flex-1">
            <header class="mb-8 border-b border-gray-200 pb-4">
                <h1 class="text-3xl font-bold text-gray-800 flex items-center gap-2">
                    <span class="text-blue-600">📂</span> {categoryTitle}
                </h1>
                <p class="text-gray-500 mt-2">
                    共 {page.total} 篇文章 (第 {page.currentPage} / {page.lastPage} 頁)
                </p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {page.data.map((post) => (
                    <article class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition overflow-hidden">
                        <a href={`${BASE_URL}/posts/${post.slug}`} class="block h-full">
                            <div class="aspect-w-16 aspect-h-9 bg-gray-100 relative h-48">
                                <img 
                                    src={fixImagePath(post.data.cover)} 
                                    alt={post.data.title}
                                    class="w-full h-full object-cover transition duration-300 hover:scale-105"
                                    loading="lazy"
                                />
                            </div>
                            <div class="p-4">
                                <h2 class="text-lg font-bold text-gray-800 mb-2 line-clamp-2 hover:text-blue-600">
                                    {post.data.title}
                                </h2>
                                <div class="flex flex-wrap gap-2 text-xs text-gray-500 mb-3">
                                    <span>📅 {new Date(post.data.date).toLocaleDateString('zh-TW')}</span>
                                    {post.data.tags && post.data.tags.slice(0, 3).map((tag: string) => (
                                        <span class="bg-gray-100 px-2 py-0.5 rounded">{tag}</span>
                                    ))}
                                </div>
                            </div>
                        </a>
                    </article>
                ))}
            </div>

            {page.total === 0 && (
                <div class="text-center py-20 text-gray-500">
                    <p class="text-xl">此分類目前沒有文章。</p>
                    <a href={BASE_URL} class="text-blue-500 hover:underline mt-4 inline-block">返回首頁</a>
                </div>
            )}

            <!-- Pagination Controls -->
            {page.lastPage > 1 && (
                <div class="mt-12 flex justify-center gap-2">
                    {page.url.prev ? (
                        <a href={page.url.prev} class="px-4 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50">
                            &larr; 上一頁
                        </a>
                    ) : (
                        <span class="px-4 py-2 border border-gray-200 text-gray-300 rounded cursor-not-allowed">
                            &larr; 上一頁
                        </span>
                    )}
                    
                    <span class="px-4 py-2 text-gray-500">
                        {page.currentPage} / {page.lastPage}
                    </span>

                    {page.url.next ? (
                        <a href={page.url.next} class="px-4 py-2 bg-white border border-gray-300 rounded hover:bg-gray-50">
                            下一頁 &rarr;
                        </a>
                    ) : (
                        <span class="px-4 py-2 border border-gray-200 text-gray-300 rounded cursor-not-allowed">
                            下一頁 &rarr;
                        </span>
                    )}
                </div>
            )}
        </div>

        <!-- Sidebar -->
        <Sidebar />
    </main>
</Layout>
